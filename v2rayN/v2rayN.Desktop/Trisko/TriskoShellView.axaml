<UserControl
    x:Class="v2rayN.Desktop.Trisko.TriskoShellView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tr="clr-namespace:ServiceLib.Trisko;assembly=ServiceLib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gek="clr-namespace:ServiceLib.Trisko;assembly=ServiceLib"
    xmlns:deskgek="using:v2rayN.Desktop.Trisko"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="TriskoShellRoot"
    x:DataType="gek:TriskoShellViewModel"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

        <UserControl.Resources>
        <StreamGeometry x:Key="UnlockIconData">M5 10h14v12H5z M8 10V7a4 4 0 0 1 7-2l-1.5 1.3A2 2 0 0 0 10 7v3z M7 14h2v3H7z M11 14h2v3h-2z M15 14h2v3h-2z</StreamGeometry>
        <StreamGeometry x:Key="FavoriteStar">M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.2L5.8 21 7 14.2 2 9.3l6.9-1z</StreamGeometry>
        <StreamGeometry x:Key="SearchMenuIconData">M11 6C13.7614 6 16 8.23858 16 11M16.6588 16.6549L21 21M19 11C19 15.4183 15.4183 19 11 19C6.58172 19 3 15.4183 3 11C3 6.58172 6.58172 3 11 3C15.4183 3 19 6.58172 19 11Z</StreamGeometry>
        <DataTemplate x:Key="SubscriptionUsageTemplate" x:DataType="gek:TriskoSubscriptionUsagePresentation">
            <StackPanel Margin="0,3,0,0" Spacing="5">
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                    Text="{Binding PrimaryText}"
                    TextWrapping="Wrap" />
                <ProgressBar
                    Height="7"
                    Minimum="0"
                    Maximum="100"
                    Background="{DynamicResource TriskoCardBackground}"
                    Foreground="{Binding ProgressColor}"
                    IsVisible="{Binding HasLimit}"
                    Value="{Binding Percentage}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasMetadata}">
                    <TextBlock FontSize="10" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{Binding SecondaryText}" />
                    <TextBlock Grid.Column="1" FontSize="10" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{Binding ExpiryText}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AnyDeskConnectionTemplate" x:DataType="gek:TriskoAnyDeskConnection">
            <Border Padding="18" Classes="resourceCard" Classes.pinned="{Binding IsPinned}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static tr:TriskoStrings.S36b4c0b07f08c596}" Command="{Binding DataContext.ConnectAnyDeskCommand, ElementName=TriskoShellRoot}" CommandParameter="{Binding}" />
                        <MenuItem Header="{x:Static tr:TriskoStrings.S5655bba23bb596c6}" Command="{Binding DataContext.ToggleAnyDeskFavoriteCommand, ElementName=TriskoShellRoot}" CommandParameter="{Binding}">
                            <MenuItem.Icon><PathIcon Width="14" Height="14" Data="{StaticResource FavoriteStar}" Foreground="#F3C84B" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static tr:TriskoStrings.S6b371a22a6841ba9}" Command="{Binding DataContext.ToggleAnyDeskPinCommand, ElementName=TriskoShellRoot}" CommandParameter="{Binding}" />
                        <MenuItem Header="{x:Static tr:TriskoStrings.Sfdd9c62231fda8e4}" Command="{Binding DataContext.RenameAnyDeskCommand, ElementName=TriskoShellRoot}" CommandParameter="{Binding}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Padding="8,4" VerticalAlignment="Center" Background="{DynamicResource TriskoNavActiveBackground}" BorderBrush="{DynamicResource TriskoCardBorderHover}" BorderThickness="1" CornerRadius="6">
                            <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TriskoCardBorderHover}" Text="{Binding BadgeText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                        <Border Padding="8,4" VerticalAlignment="Center" Background="{DynamicResource TriskoSubCardBackground}" CornerRadius="6">
                            <TextBlock FontSize="9" FontWeight="Bold" Foreground="{Binding StatusColor}" Text="{Binding StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Classes="favoriteAction" Classes.favorite="{Binding IsFavorite}" Command="{Binding DataContext.ToggleAnyDeskFavoriteCommand, ElementName=TriskoShellRoot}" CommandParameter="{Binding}" ToolTip.Tip="{x:Static tr:TriskoStrings.Se4c1d01c5c8f2193}" AutomationProperties.Name="{x:Static tr:TriskoStrings.S072575b3f14c4ae5}">
                            <PathIcon Width="16" Height="16" Data="{StaticResource FavoriteStar}" />
                        </Button>
                        <Button Classes="cardPinAction" Classes.pinned="{Binding IsPinned}" Command="{Binding DataContext.ToggleAnyDeskPinCommand, ElementName=TriskoShellRoot}" CommandParameter="{Binding}" ToolTip.Tip="{x:Static tr:TriskoStrings.S6b371a22a6841ba9}">
                            <PathIcon Width="14" Height="14" Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z" />
                        </Button>
                        <Button Classes="cardEditAction" Command="{Binding DataContext.RenameAnyDeskCommand, ElementName=TriskoShellRoot}" CommandParameter="{Binding}" ToolTip.Tip="{x:Static tr:TriskoStrings.S7fea6df302f808e8}">
                            <PathIcon Width="14" Height="14" Data="M7 7H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-1 M20.385 6.585a2.1 2.1 0 0 0-2.97-2.97L9 12v3h3z M16 5l3 3" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,2,0,2">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TriskoCardTitleForeground}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{Binding SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Stretch"
                        Classes="primaryAction"
                        Command="{Binding DataContext.ConnectAnyDeskCommand, ElementName=TriskoShellRoot}"
                        CommandParameter="{Binding}"
                        Content="{x:Static tr:TriskoStrings.S36b4c0b07f08c596}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ResourceCardTemplate" x:DataType="gek:TriskoResourceItemViewModel">
            <Border
                MinHeight="228"
                HorizontalAlignment="Stretch"
                Padding="20"
                Classes="resourceCard"
                Classes.pinned="{Binding IsPinned}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Header="{Binding OpenButtonText}"
                            Command="{Binding OpenCommand}"
                            IsEnabled="{Binding CanOpen}">
                            <MenuItem.Icon>
                                <PathIcon Width="14" Height="14" Data="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4m-8-2l8-8m0 0v5m0-5h-5" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="{x:Static tr:TriskoStrings.Sb8b151d4174391f0}"
                            Command="{Binding EditCommand}">
                            <MenuItem.Icon>
                                <PathIcon Width="14" Height="14" Data="M7 7H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-1 M20.385 6.585a2.1 2.1 0 0 0-2.97-2.97L9 12v3h3z M16 5l3 3" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="{Binding PinToolTipText}"
                            Command="{Binding TogglePinCommand}">
                            <MenuItem.Icon>
                                <PathIcon Width="14" Height="14" Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="{Binding AutoLaunchToolTipText}"
                            Command="{Binding ToggleAutoLaunchCommand}">
                            <MenuItem.Icon>
                                <PathIcon Width="14" Height="14" Data="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.9 17.55 11 21 11 21z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Header="{x:Static tr:TriskoStrings.S038edde9e7beb6d5}"
                            Command="{Binding DeleteCommand}"
                            Foreground="#F0717E">
                            <MenuItem.Icon>
                                <PathIcon Width="14" Height="14" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Foreground="#F0717E" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Кнопка закрепления в самом верхнем левом углу карточки -->
                    <Button
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="-18,-18,0,0"
                        AutomationProperties.Name="{x:Static tr:TriskoStrings.S4e3feb28ae023fa0}"
                        Classes="cardPinAction"
                        Classes.pinned="{Binding IsPinned}"
                        Command="{Binding TogglePinCommand}"
                        ToolTip.Tip="{Binding PinToolTipText}">
                        <PathIcon
                            Width="14"
                            Height="14"
                            Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z" />
                    </Button>

                    <!-- Верхний блок карточки -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <!-- Левая колонка: Иконка типа подключения -->
                        <Border
                            Width="48"
                            Height="48"
                            Background="{DynamicResource TriskoSettingIconBackground}"
                            CornerRadius="14">
                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Width="26" Height="26" Source="/Assets/Trisko/Icons/rdp.png" IsVisible="{Binding IsRdp}" />
                                <Image Width="26" Height="26" Source="/Assets/Trisko/Icons/folder.png" IsVisible="{Binding IsSmb}" />
                                <Image Width="26" Height="26" Source="/Assets/Trisko/Icons/ssh.png" IsVisible="{Binding IsSsh}" />
                            </Panel>
                        </Border>

                        <!-- Центральная колонка: Название + строка статуса и бейдж автозапуска -->
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TriskoCardTitleForeground}"
                                MaxLines="2"
                                Text="{Binding DisplayName}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="{Binding AvailabilityColor}" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding AvailabilityColor}"
                                        Text="{Binding AvailabilityText}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <Border
                                    Padding="5,1.5"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource TriskoSubCardBackground}"
                                    BorderBrush="{DynamicResource TriskoBrandSubtitleForeground}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    IsVisible="{Binding AutoLaunchOnVpn}"
                                    ToolTip.Tip="{x:Static tr:TriskoStrings.S7bf79faf83d89fd3}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock FontSize="9" Text="⚡" VerticalAlignment="Center" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                        <TextBlock FontSize="9" FontWeight="SemiBold" Text="{x:Static tr:TriskoStrings.S18d54d8fcef74ea2}" VerticalAlignment="Center" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Правая колонка: Кнопка "Изменить" при наведении (с круглым фоном) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                        <Button Classes="favoriteAction" Classes.favorite="{Binding IsFavorite}" Command="{Binding ToggleFavoriteCommand}"
                            ToolTip.Tip="{x:Static tr:TriskoStrings.Se4c1d01c5c8f2193}" AutomationProperties.Name="{x:Static tr:TriskoStrings.Se267b0950ce5ef09}">
                            <PathIcon Width="16" Height="16" Data="{StaticResource FavoriteStar}" />
                        </Button>
                        <Button
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{x:Static tr:TriskoStrings.S06912c181fae5135}"
                            Classes="cardEditAction"
                            Command="{Binding EditCommand}"
                            ToolTip.Tip="{x:Static tr:TriskoStrings.Sb03e2655b08db257}">
                            <PathIcon Width="14" Height="14" Data="M7 7H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-1 M20.385 6.585a2.1 2.1 0 0 0-2.97-2.97L9 12v3h3z M16 5l3 3" />
                        </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,16,0,12" Spacing="8">
                        <TextBlock
                            Foreground="{DynamicResource TriskoCardSubtitleForeground}"
                            MaxLines="2"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                            MaxLines="2"
                            Text="{Binding TargetText}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Button
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{Binding OpenButtonText}"
                            Classes="primaryAction"
                            Command="{Binding OpenCommand}"
                            Content="{Binding OpenButtonText}"
                            IsEnabled="{Binding CanOpen}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EcpDeviceCardTemplate" x:DataType="gek:TriskoEcpDeviceViewModel">
            <Border MinHeight="240" Padding="20" Classes="resourceCard">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static tr:TriskoStrings.S3af435b32ee7f87e}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" />
                        <MenuItem Header="{x:Static tr:TriskoStrings.Sbb5bdd176cdf98df}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}" />
                        <Separator />
                        <MenuItem Header="{Binding AutoUseDeviceText}" Command="{Binding ToggleAutoUseDeviceCommand}" />
                        <MenuItem Header="{Binding AutoUsePortText}" Command="{Binding ToggleAutoUsePortCommand}" />
                        <Separator />
                        <MenuItem Header="{x:Static tr:TriskoStrings.S5ecad382f1c68457}" Command="{Binding RefreshCommand}" />
                        <MenuItem Header="{x:Static tr:TriskoStrings.S40eb0b6fc23a33b7}" Command="{Binding OpenVirtualHereCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="48" Height="48" Background="{DynamicResource TriskoSettingIconBackground}" CornerRadius="14">
                            <Image
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Assets/Trisko/Icons/ecp.png" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Classes="cardTitle" Text="{Binding DisplayName}" TextWrapping="Wrap" MaxLines="2" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding StatusColor}" />
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColor}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="2" Padding="7,3" VerticalAlignment="Top" Background="{DynamicResource TriskoSubCardBackground}" CornerRadius="7" IsVisible="{Binding IsStorageDevice}">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{x:Static tr:TriskoStrings.Saf3c47e8be97930e}" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,16,0,14" Spacing="7">
                        <TextBlock Classes="cardSubtitle" Text="{Binding ServerText}" TextWrapping="Wrap" />
                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding Address}" />
                        <TextBlock FontSize="11" Classes="sectionSubtitle" Text="{Binding SerialText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        Classes.primaryAction="{Binding IsAvailable}"
                        Classes.warningAction="{Binding IsInUseLocally}"
                        Classes.secondaryAction="{Binding !CanRunPrimaryAction}"
                        Command="{Binding PrimaryActionCommand}"
                        Content="{Binding PrimaryActionText}"
                        IsEnabled="{Binding CanRunPrimaryAction}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.nav">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TriskoNavForeground}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoNavHoverBackground}" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource TriskoNavActiveBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoNavActiveBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource TriskoNavActiveForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Image.navIcon">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="23" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.sidebar">
            <Setter Property="Width" Value="272" />
            <Setter Property="Background" Value="{DynamicResource TriskoSidebarBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoSidebarBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.sidebar.collapsed">
            <Setter Property="Width" Value="76" />
        </Style>
        <Style Selector="Border.sidebar.collapsed Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.sidebarToggle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TriskoSidebarToggleBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoSidebarToggleBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sidebarToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoSidebarToggleHoverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoSidebarToggleHoverBorder}" />
        </Style>
        <Style Selector="Border.remoteDesktopCard">
            <Setter Property="Background" Value="{DynamicResource TriskoCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Expander.remoteDesktopMethod">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="StackPanel.remoteDesktopBody">
            <Setter Property="Margin" Value="12,4,12,12" />
            <Setter Property="Spacing" Value="12" />
        </Style>
        <Style Selector="Border.card, Border.resourceCard">
            <Setter Property="Background" Value="{DynamicResource TriskoCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BoxShadow" Value="0 5 15 0 #1A000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card:pointerover, Border.resourceCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>
        <Style Selector="Border.card.vpnServersCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
        </Style>
        <Style Selector="Border.resourceCard.pinned">
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoBrandSubtitleForeground}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <!-- Button pin in top-left of card -->
        <Style Selector="Button.cardPinAction">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TriskoSectionSubtitleForeground}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.cardPinAction PathIcon">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.resourceCard:pointerover Button.cardPinAction">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.cardPinAction.pinned">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.cardPinAction.pinned PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TriskoPrimaryActionBackground}" />
            <Setter Property="RenderTransform" Value="rotate(45deg)" />
        </Style>
        <Style Selector="Button.cardPinAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoSecondaryActionHoverBackground}" />
        </Style>

        <!-- Button edit in top-right of card -->
        <Style Selector="Button.cardEditAction">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TriskoSecondaryActionBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoSecondaryActionBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TriskoSectionSubtitleForeground}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.resourceCard:pointerover Button.cardEditAction">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.cardEditAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoSecondaryActionHoverBackground}" />
