<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tr="clr-namespace:ServiceLib.Geksa;assembly=ServiceLib"
             x:Class="v2rayN.Desktop.Geksa.GeksaVncPanel">
    <StackPanel Spacing="12">
        <WrapPanel ItemSpacing="8" LineSpacing="6">
            <StackPanel x:Name="WorkstationIdentity" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="False">
                <TextBlock x:Name="WorkstationLabel" Classes="sectionSubtitle" VerticalAlignment="Center" />
                <SelectableTextBlock x:Name="WorkstationValue" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="SetupIncomingButton" Classes="secondaryAction" Content="{x:Static tr:TriskoStrings.S21cb41929dcb9b94}"
                    Click="SetupIncoming_Click" IsVisible="False" />
        </WrapPanel>
        <Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="8">
            <TextBox x:Name="HostBox" Classes="remoteInput" PlaceholderText="{x:Static tr:TriskoStrings.Sd343cbabc004b778}" AutomationProperties.Name="{x:Static tr:TriskoStrings.S4c8fcd6da1bf3b9f}" />
            <TextBox x:Name="ClientPasswordBox" Grid.Column="1" Classes="remoteInput" PasswordChar="●" PlaceholderText="{x:Static tr:TriskoStrings.S2fe04a29706f6d9b}" AutomationProperties.Name="{x:Static tr:TriskoStrings.S2fe04a29706f6d9b}" />
            <Button Grid.Column="2" Classes="primaryAction" Content="{x:Static tr:TriskoStrings.S36b4c0b07f08c596}" Click="Connect_Click" />
        </Grid>
        <TextBlock x:Name="ClientStatus" Classes="sectionSubtitle" TextWrapping="Wrap"
                   IsVisible="{Binding #ClientStatus.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <WrapPanel ItemSpacing="8" LineSpacing="6">
            
            <Button Classes="secondaryAction" Content="{x:Static tr:TriskoStrings.S985b5e0f2ccf1ba0}" Click="OpenSettings_Click"
                    AutomationProperties.Name="{x:Static tr:TriskoStrings.S5244e86a155f9941}" />
        </WrapPanel>
        

        <ContentControl x:Name="SettingsSlot" IsVisible="False">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,110" ColumnSpacing="12">
                    <TextBlock Classes="sectionSubtitle" VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.Seb476cc933e1da11}" />
                    <TextBox x:Name="ClientPortBox" Grid.Column="1" Text="5900" AutomationProperties.Name="{x:Static tr:TriskoStrings.S1c01e643ae71aedc}" />
                </Grid>
                <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Se924243b8513f09f}" TextWrapping="Wrap" />
                
                <Expander x:Name="VncServerPanel" Header="{x:Static tr:TriskoStrings.Sb7bf4b3f92aae694}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S6bba98e71580523c}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Classes="sectionSubtitle" VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S5366ea3494b9c44f}" />
                            <TextBox x:Name="ServerPortBox" Grid.Column="1" Text="5900" MaxWidth="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Classes="sectionSubtitle" VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.Sf104cf99dcdb5ddf}" />
                            <TextBox x:Name="ServerPasswordBox" Grid.Row="1" Grid.Column="1" PasswordChar="●" MaxLength="8" PlaceholderText="{x:Static tr:TriskoStrings.S8867fd2ed76b1729}" />
                            <TextBlock Grid.Row="2" Classes="sectionSubtitle" VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S5b6b9cebd7cd1a2d}" />
                            <TextBox x:Name="AllowedAddressesBox" Grid.Row="2" Grid.Column="1" Text="LocalSubnet" PlaceholderText="{x:Static tr:TriskoStrings.Sf3e3f8295e679989}" />
                        </Grid>
                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S2040cb3df1574a52}" TextWrapping="Wrap" />
                        <CheckBox x:Name="AutoStartBox" Content="{x:Static tr:TriskoStrings.Saf4d8d4b87280730}" />
                        <CheckBox x:Name="LoopbackBox" Content="{x:Static tr:TriskoStrings.S76de79c683ce74de}" />
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button x:Name="EnableServerButton" Classes="geksaPrimary" Content="{x:Static tr:TriskoStrings.S88995740eb7a1d35}" Click="EnableServer_Click" />
                            <Button x:Name="DisableServerButton" Classes="geksaSecondary" Content="{x:Static tr:TriskoStrings.S5c2e70b2a351eae9}" Click="DisableServer_Click" />
                            <Button x:Name="RefreshServerButton" Classes="geksaSecondary" Content="{x:Static tr:TriskoStrings.S83553fb558576062}" Click="RefreshServer_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="ServerStatus" Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Scdd8b6cd4b65cb5a}" TextWrapping="Wrap" />
                        <TextBlock x:Name="LocalAddresses" Classes="sectionSubtitle" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
