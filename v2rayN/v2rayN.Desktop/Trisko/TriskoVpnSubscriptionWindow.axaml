<Window
    x:Class="v2rayN.Desktop.Trisko.TriskoVpnSubscriptionWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tr="clr-namespace:ServiceLib.Trisko;assembly=ServiceLib"
    xmlns:gek="clr-namespace:ServiceLib.Trisko;assembly=ServiceLib"
    x:DataType="gek:TriskoVpnSubscriptionViewModel"
    Width="720"
    Height="510"
    Background="{DynamicResource TriskoShellBackground}"
    CanResize="False"
    Title="{x:Static tr:TriskoStrings.Sf925ff81b5a48f4b}"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="28" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="7">
            <TextBlock
                FontSize="25"
                FontWeight="Bold"
                Foreground="{DynamicResource TriskoBrandTitleForeground}"
                Text="{x:Static tr:TriskoStrings.Sf925ff81b5a48f4b}" />
            <TextBlock
                Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                Text="{x:Static tr:TriskoStrings.S7dd0e7a50b1cecc2}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,26,0,18" Spacing="14">
            <StackPanel Spacing="7">
                <TextBlock Text="{x:Static tr:TriskoStrings.S336d6a7527bc0d35}" />
                <TextBox Text="{Binding SubscriptionName, Mode=TwoWay}" PlaceholderText="My VPN" />
            </StackPanel>
            <StackPanel Spacing="7">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TriskoSectionTitleForeground}"
                    Text="{x:Static tr:TriskoStrings.S6d3299881b779ddb}" />
                <TextBox
                    Height="42"
                    AutomationProperties.Name="{x:Static tr:TriskoStrings.Sbce875270d0b623e}"
                    PlaceholderText="https://sub.example.ru/..."
                    Text="{Binding SubscriptionUrl, Mode=TwoWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                    Text="{x:Static tr:TriskoStrings.S4523194c169ed2ef}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="13,10"
                Background="{DynamicResource TriskoErrorBoxBackground}"
                BorderBrush="{DynamicResource TriskoErrorBoxBorder}"
                BorderThickness="1"
                CornerRadius="9"
                IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock
                    Foreground="{DynamicResource TriskoErrorTextForeground}"
                    Text="{Binding ValidationMessage}"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
            <Button MinWidth="110" Classes="triskoSecondary" Click="CancelClick" Content="{x:Static tr:TriskoStrings.S7996f711496a5424}" />
            <Button MinWidth="190" Classes="triskoPrimary" Click="SaveClick" Content="{x:Static tr:TriskoStrings.Sfc117ff050685d05}" />
        </StackPanel>
    </Grid>
</Window>
