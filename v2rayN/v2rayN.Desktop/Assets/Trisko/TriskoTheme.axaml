<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:trisko="using:v2rayN.Desktop.Trisko">
    <!-- Matches the shared blue used by the sidebar PNG icons in every theme. -->
    <SolidColorBrush x:Key="TriskoNavIconForeground">#5B8CFF</SolidColorBrush>
    <DrawingImage x:Key="TriskoLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,108,108" /></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#5B8DFF" Geometry="M48,10 C41,10 37,15 37,23 L37,66 C37,84 47,94 63,96 C72,97 80,94 83,87 C86,81 82,75 75,74 L65,72 C60,71 58,68 58,63 L58,21 C58,14 54,10 48,10 Z" />
                <GeometryDrawing Brush="#3264C8" Geometry="M37,52 L58,44 L58,63 C58,68 60,71 65,72 L75,74 C82,75 86,81 83,87 C74,82 54,76 45,69 C39,65 37,59 37,52 Z" />
                <GeometryDrawing Brush="#8AB0FF" Geometry="M26,37 L73,20 C81,17 88,21 90,28 C92,35 88,40 81,43 L33,60 C25,63 19,68 18,74 L18,53 C18,46 20,40 26,37 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <ResourceDictionary.ThemeDictionaries>
        
        <!-- ============================== -->
        <!-- BLUE THEME (Default Trisko)     -->
        <!-- ============================== -->
        <ResourceDictionary x:Key="{x:Static trisko:TriskoThemeVariants.Brand}">
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="TriskoShellBackground">#10151E</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarBackground">#121923</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarBorder">#2B3C51</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardBackground">#171E29</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardBorder">#304157</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardBorderHover">#4F8CFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardBackground">#1C2532</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardBorder">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSeparatorBackground">#26374B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoModalBackdropBackground">#CC10151E</SolidColorBrush>
            
            <SolidColorBrush x:Key="TriskoNavHoverBackground">#1B2738</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavActiveBackground">#203451</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavActiveBorder">#356BD4</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavForeground">#939FB3</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavActiveForeground">#EDF4FF</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoSecondaryActionBackground">#202D40</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSecondaryActionBorder">#355887</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSecondaryActionForeground">#E2EBFA</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSecondaryActionHoverBackground">#293C58</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoPrimaryActionBackground">#2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoPrimaryActionBorder">#2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoPrimaryActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoPrimaryActionHoverBackground">#1D4ED8</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoWarningActionBackground">#D97706</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoWarningActionBorder">#F59E0B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoWarningActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoWarningActionHoverBackground">#B45309</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoDangerActionBackground">#B91C1C</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoDangerActionBorder">#DC2626</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoDangerActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoDangerActionHoverBackground">#991B1B</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoSidebarToggleBackground">#14263B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarToggleBorder">#2A3E56</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarToggleHoverBackground">#1D344F</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarToggleHoverBorder">#4F7CFA</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoQuickCardBackground">#171E29</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardBorder">#304157</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardHoverBackground">#132840</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardHoverBorder">#4774C8</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardForeground">#F3F7FD</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoSettingIconBackground">#142A4E</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSettingIconForeground">#6F9CFF</SolidColorBrush>

            <!-- Texts -->
            <SolidColorBrush x:Key="TriskoBrandTitleForeground">White</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoBrandSubtitleForeground">#4F8CFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSectionTitleForeground">White</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSectionSubtitleForeground">#8190A6</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardTitleForeground">White</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardSubtitleForeground">#8D98AC</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardLabelForeground">#74849B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardValueForeground">#E5EDF8</SolidColorBrush>
            
            <SolidColorBrush x:Key="TriskoErrorBoxBackground">#351E27</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoErrorBoxBorder">#733748</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoErrorTextForeground">#F4A5B4</SolidColorBrush>

        </ResourceDictionary>

        <!-- ============================== -->
        <!-- DARK THEME (Pure Dark)         -->
        <!-- ============================== -->
        <ResourceDictionary x:Key="Dark">
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="TriskoShellBackground">#09090B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarBackground">#18181B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarBorder">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardBackground">#18181B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardBorder">#3F3F46</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardBorderHover">#71717A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardBorder">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSeparatorBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoModalBackdropBackground">#D809090B</SolidColorBrush>
            
            <SolidColorBrush x:Key="TriskoNavHoverBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavActiveBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavActiveBorder">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavForeground">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavActiveForeground">#FAFAFA</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoSecondaryActionBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSecondaryActionBorder">#3F3F46</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSecondaryActionForeground">#E4E4E7</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSecondaryActionHoverBackground">#3F3F46</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoPrimaryActionBackground">#2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoPrimaryActionBorder">#3B82F6</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoPrimaryActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoPrimaryActionHoverBackground">#1D4ED8</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoWarningActionBackground">#D97706</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoWarningActionBorder">#F59E0B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoWarningActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoWarningActionHoverBackground">#B45309</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoDangerActionBackground">#B91C1C</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoDangerActionBorder">#EF4444</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoDangerActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoDangerActionHoverBackground">#991B1B</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoSidebarToggleBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarToggleBorder">#3F3F46</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarToggleHoverBackground">#3F3F46</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarToggleHoverBorder">#A1A1AA</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoQuickCardBackground">#18181B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardBorder">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardHoverBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardHoverBorder">#52525B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardForeground">#FAFAFA</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoSettingIconBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSettingIconForeground">#E4E4E7</SolidColorBrush>

            <!-- Texts -->
            <SolidColorBrush x:Key="TriskoBrandTitleForeground">#FAFAFA</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoBrandSubtitleForeground">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSectionTitleForeground">#FAFAFA</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSectionSubtitleForeground">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardTitleForeground">#FAFAFA</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardSubtitleForeground">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardLabelForeground">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardValueForeground">#FAFAFA</SolidColorBrush>
            
            <SolidColorBrush x:Key="TriskoErrorBoxBackground">#450A0A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoErrorBoxBorder">#7F1D1D</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoErrorTextForeground">#FECACA</SolidColorBrush>

        </ResourceDictionary>

        <!-- ============================== -->
        <!-- LIGHT THEME                    -->
        <!-- ============================== -->
        <ResourceDictionary x:Key="Light">
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="TriskoShellBackground">#EDF2F7</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarBackground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarBorder">#CBD5E1</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardBackground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardBorder">#CBD5E1</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardBorderHover">#2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardBackground">#F1F5F9</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardBorder">#CBD5E1</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSeparatorBackground">#CBD5E1</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoModalBackdropBackground">#660F172A</SolidColorBrush>
            
            <SolidColorBrush x:Key="TriskoNavHoverBackground">#E2E8F0</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavActiveBackground">#EFF6FF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavActiveBorder">#2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavForeground">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoNavActiveForeground">#1D4ED8</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoSecondaryActionBackground">#F1F5F9</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSecondaryActionBorder">#CBD5E1</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSecondaryActionForeground">#0F172A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSecondaryActionHoverBackground">#E2E8F0</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoPrimaryActionBackground">#2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoPrimaryActionBorder">#1D4ED8</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoPrimaryActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoPrimaryActionHoverBackground">#1D4ED8</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoWarningActionBackground">#D97706</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoWarningActionBorder">#B45309</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoWarningActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoWarningActionHoverBackground">#B45309</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoDangerActionBackground">#B91C1C</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoDangerActionBorder">#991B1B</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoDangerActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoDangerActionHoverBackground">#991B1B</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoSidebarToggleBackground">#F1F5F9</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarToggleBorder">#CBD5E1</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarToggleHoverBackground">#E2E8F0</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSidebarToggleHoverBorder">#2563EB</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoQuickCardBackground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardBorder">#CBD5E1</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardHoverBackground">#F8FAFC</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardHoverBorder">#2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoQuickCardForeground">#0F172A</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoSettingIconBackground">#EFF6FF</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSettingIconForeground">#2563EB</SolidColorBrush>

            <!-- Texts -->
            <SolidColorBrush x:Key="TriskoBrandTitleForeground">#0F172A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoBrandSubtitleForeground">#2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSectionTitleForeground">#0F172A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSectionSubtitleForeground">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardTitleForeground">#0F172A</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoCardSubtitleForeground">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardLabelForeground">#475569</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoSubCardValueForeground">#0F172A</SolidColorBrush>

            <SolidColorBrush x:Key="TriskoErrorBoxBackground">#FEF2F2</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoErrorBoxBorder">#F87171</SolidColorBrush>
            <SolidColorBrush x:Key="TriskoErrorTextForeground">#B91C1C</SolidColorBrush>

        </ResourceDictionary>
        
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
