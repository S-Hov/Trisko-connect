<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tr="clr-namespace:ServiceLib.Trisko;assembly=ServiceLib"
        xmlns:gek="clr-namespace:ServiceLib.Trisko;assembly=ServiceLib"
        xmlns:local="using:v2rayN.Desktop.Trisko"
        x:Class="v2rayN.Desktop.Trisko.TriskoCompactConnectionWindow"
        x:DataType="gek:TriskoShellViewModel"
        Width="360" Height="440" MinWidth="340" MinHeight="400"
        Title="{x:Static tr:TriskoStrings.S8a9082d2546d6df9}" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TriskoShellBackground}">
    <Window.Styles>
        <StyleInclude Source="/Assets/Trisko/TriskoStyles.axaml" />
    </Window.Styles>
    <ThemeVariantScope x:Name="CompactThemeScope">
        <Panel Background="{DynamicResource TriskoShellBackground}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Trisko connect" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TriskoCardTitleForeground}" />
                            <TextBlock Text="{Binding StateTitle}" Foreground="{Binding StatusColor}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="{x:Static tr:TriskoStrings.S8e09a624b4a741fb}" FontSize="11" VerticalAlignment="Top"
                                  Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                  IsChecked="{Binding $parent[Window].Topmost, Mode=TwoWay}" />
                    </Grid>
                    <Viewbox Grid.Row="1" Width="190" Height="190" HorizontalAlignment="Center" Stretch="Uniform">
                        <local:TriskoConnectionButton IsAnimationEnabled="{Binding $parent[Window].IsVisible}" />
                    </Viewbox>
                    <StackPanel Grid.Row="2" Spacing="5">
                        <TextBlock Text="{x:Static tr:TriskoStrings.S5a03382f1926059f}" FontSize="12" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" />
                        <ComboBox ItemsSource="{Binding VpnProfiles}" SelectedItem="{Binding SelectedVpnProfile, Mode=OneWay}"
                                  IsEnabled="{Binding CanSelectVpnProfile}" HorizontalAlignment="Stretch" SelectionChanged="Server_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="gek:TriskoVpnProfileOption">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding EffectiveVpnProfile.DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" />
                            <TextBlock Text="{Binding EffectiveVpnProfile.DelayText}" Foreground="{Binding EffectiveVpnProfile.DelayColor}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="triskoSecondary" Padding="12,7" FontSize="12" Command="{Binding TestLatencyCommand}" IsEnabled="{Binding CanTestLatency}" Content="{x:Static tr:TriskoStrings.Sfd2ccf3a4291152c}" />
                    </Grid>
                    <StackPanel Grid.Row="4" Spacing="8" IsVisible="{Binding IsReconnectPending}">
                        <TextBlock Text="{Binding ReconnectCountdownText}" FontSize="12" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="triskoSecondary" Content="{x:Static tr:TriskoStrings.S7a4f6595b5ed6fd4}" Command="{Binding RetryConnectionNowCommand}" />
                            <Button Classes="triskoSecondary" Content="{x:Static tr:TriskoStrings.S7c47f7292ba4f2ae}" Command="{Binding CancelReconnectCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <local:TriskoNotificationsView DataContext="{Binding Notifications}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" MaxHeight="170" />
        </Panel>
    </ThemeVariantScope>
</Window>
