        </Style>
        <Style Selector="Button.powerAction">
            <Setter Property="Width" Value="176" />
            <Setter Property="Height" Value="176" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="88" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
                <ScaleTransform />
            </Setter>
        </Style>
        <Style Selector="Button.powerAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#18FFFFFF" />
        </Style>
        <Style Selector="Button.powerAction:disabled">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.powerAction:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Border.connectionDurationBadge">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#183FD69A" />
            <Setter Property="BorderBrush" Value="#503FD69A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Grid.shellRoot">
            <Setter Property="Background" Value="{DynamicResource TriskoShellBackground}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.brandTitle">
            <Setter Property="Foreground" Value="{DynamicResource TriskoBrandTitleForeground}" />
        </Style>
        <Style Selector="TextBlock.brandSubtitle">
            <Setter Property="Foreground" Value="{DynamicResource TriskoBrandSubtitleForeground}" />
        </Style>
        <Style Selector="Border.separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource TriskoSeparatorBackground}" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="Foreground" Value="{DynamicResource TriskoCardTitleForeground}" />
        </Style>
        <Style Selector="TextBlock.cardSubtitle">
            <Setter Property="Foreground" Value="{DynamicResource TriskoCardSubtitleForeground}" />
        </Style>
        <Style Selector="Border.subCard">
            <Setter Property="Background" Value="{DynamicResource TriskoSubCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoSubCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBlock.subCardLabel">
            <Setter Property="Foreground" Value="{DynamicResource TriskoSubCardLabelForeground}" />
        </Style>
        <Style Selector="TextBlock.subCardValue">
            <Setter Property="Foreground" Value="{DynamicResource TriskoSubCardValueForeground}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="Foreground" Value="{DynamicResource TriskoSectionTitleForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.sectionSubtitle">
            <Setter Property="Foreground" Value="{DynamicResource TriskoSectionSubtitleForeground}" />
        </Style>
        <Style Selector="Border.serviceProbePulse">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.errorBox">
            <Setter Property="Background" Value="{DynamicResource TriskoErrorBoxBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoErrorBoxBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBlock.errorText">
            <Setter Property="Foreground" Value="{DynamicResource TriskoErrorTextForeground}" />
        </Style>
        <Style Selector="Border.settingIcon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{DynamicResource TriskoSettingIconBackground}" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>
        <Style Selector="PathIcon.themeIcon">
            <Setter Property="Foreground" Value="{DynamicResource TriskoBrandSubtitleForeground}" />
        </Style>

        <Style Selector="Button.settingCategoryCard">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Background" Value="{DynamicResource TriskoCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.settingCategoryCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoNavHoverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>

        <Style Selector="Button.backNav">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="{DynamicResource TriskoSecondaryActionBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoSecondaryActionBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TriskoSecondaryActionForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.backNav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoSecondaryActionHoverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>

        <Style Selector="Button.quickCard">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource TriskoQuickCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoQuickCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TriskoQuickCardForeground}" />
        </Style>
        <Style Selector="Button.quickCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoQuickCardHoverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoQuickCardHoverBorder}" />
        </Style>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TriskoBrandTitleForeground}" />
        </Style>
        <Style Selector="TextBlock.pageSubtitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TriskoSectionSubtitleForeground}" />
        </Style>

        <Style Selector="TextBox.searchBox, TextBox.remoteInput">
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource TriskoSubCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TriskoCardTitleForeground}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="TextBox.searchBox:pointerover /template/ Border#PART_BorderElement, TextBox.remoteInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>
        <Style Selector="TextBox.searchBox:focus /template/ Border#PART_BorderElement, TextBox.remoteInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
            <Setter Property="Background" Value="{DynamicResource TriskoSubCardBackground}" />
        </Style>

        <Style Selector="Button.clearSearchButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.clearSearchButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoSecondaryActionHoverBackground}" />
        </Style>

        <!-- Анимация прыгающих точек для проверки пинга -->
        <Style Selector="Ellipse.pingDot">
            <Setter Property="RenderTransform">
                <TranslateTransform />
            </Setter>
        </Style>
        <Style Selector="Ellipse.pingDot1">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="30%">
                        <Setter Property="TranslateTransform.Y" Value="-3.5" />
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.pingDot2">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="20%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.Y" Value="-3.5" />
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="80%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.pingDot3">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="70%">
                        <Setter Property="TranslateTransform.Y" Value="-3.5" />
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Стили списка VPN-подключений со скруглением и разделителями -->
        <Style Selector="ListBox.vpnProfileList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,4" />
        </Style>
        <Style Selector="ListBox.vpnProfileList ListBoxItem">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="{DynamicResource TriskoCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform">
                <TransformGroup>
                    <ScaleTransform />
                </TransformGroup>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.vpnProfileList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.vpnProfileList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoNavHoverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <!-- Выразительное выделение активного/выбранного профиля с анимацией -->
        <Style Selector="ListBox.vpnProfileList ListBoxItem:selected">
            <Style.Animations>
                <Animation Duration="0:0:0.25" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.98" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.98" />
                    </KeyFrame>
                    <KeyFrame Cue="55%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.012" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.012" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ListBox.vpnProfileList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoNavActiveBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ListBox.vpnProfileList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoNavActiveBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ListBox.vpnProfileList ListBoxItem:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!-- Неактивное визуальное состояние серверов при включенном VPN (CanSelectVpnProfile == false) -->
        <Style Selector="ListBox.vpnProfileList.selectionDisabled ListBoxItem">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="ListBox.vpnProfileList.selectionDisabled ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ListBox.vpnProfileList.selectionDisabled ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <!-- Активный (подключенный) профиль остается выразительным и четким при включенном VPN -->
        <Style Selector="ListBox.vpnProfileList.selectionDisabled ListBoxItem:selected">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="ListBox.vpnProfileList.selectionDisabled ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoNavActiveBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!-- Бейдж АКТИВЕН для выбранного подключения с плавной анимацией появления -->
        <Style Selector="ListBox.vpnProfileList ListBoxItem:selected Border.activeProfileBadge">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="RenderTransform">
                <TransformGroup>
                    <ScaleTransform />
                </TransformGroup>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.3" FillMode="Forward" Easing="BackEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.3" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.3" />
                        <Setter Property="Opacity" Value="0.0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ListBox.vpnProfileList ListBoxItem:selected Border.profileIconBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>

        <!-- Кнопка проверки пинга отдельного профиля (спидометр) -->
        <Style Selector="Button.rowSpeedometerButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource TriskoSubCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.rowSpeedometerButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoNavHoverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>
        <Style Selector="Button.rowSpeedometerButton:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>
        <!-- Спидометр остается доступным даже когда сервера неактивны для переключения -->
        <Style Selector="ListBox.vpnProfileList.selectionDisabled ListBoxItem Button.rowSpeedometerButton">
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.vpnProfileList.selectionDisabled ListBoxItem Button.rowSpeedometerButton:pointerover">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <!-- Иконочные кнопки панели управления VPN (Проверить все, Обновить, Подписка) -->
        <Style Selector="Button.vpnHeaderIconButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource TriskoSecondaryActionBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoSecondaryActionBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.vpnHeaderIconButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoSecondaryActionHoverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>
        <Style Selector="Button.vpnHeaderIconButton:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>

        <!-- Стиль островка активного подключения при включенном VPN -->
        <Style Selector="Border.subCard.connectedProfile">
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
            <Setter Property="Background" Value="{DynamicResource TriskoNavActiveBackground}" />
        </Style>

        <!-- Кнопка сворачивания/разворачивания группы подключений -->
        <Style Selector="Button.groupHeaderCollapseButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="-8,-6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.groupHeaderCollapseButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoNavHoverBackground}" />
        </Style>
        <Style Selector="Button.groupHeaderCollapseButton:pointerover Border.groupChevronBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
            <Setter Property="Background" Value="{DynamicResource TriskoNavActiveBackground}" />
        </Style>
        <Style Selector="Button.groupHeaderCollapseButton:pointerover PathIcon.groupChevronIcon">
            <Setter Property="Foreground" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>

        <!-- Чип для шеврона сворачивания -->
        <Style Selector="Border.groupChevronBorder">
            <Setter Property="Background" Value="{DynamicResource TriskoCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Анимация вращения шеврона (-90deg = свернуто/стрелка вправо, 0deg = развернуто/стрелка вниз) -->
        <Style Selector="PathIcon.groupChevronIcon">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="PathIcon.groupChevronIcon.isExpanded">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>

        <Style Selector="Button.favoriteAction">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TriskoSectionSubtitleForeground}" />
        </Style>
        <Style Selector="Border.resourceCard:pointerover Button.favoriteAction, Grid.vpnProfileItemRow:pointerover Button.favoriteAction, Button.favoriteAction:focus-visible, Button.favoriteAction.favorite">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.favoriteAction.favorite">
            <Setter Property="Foreground" Value="#F3C84B" />
        </Style>
        <Style Selector="Button.favoriteAction PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TriskoSectionSubtitleForeground}" />
        </Style>
        <Style Selector="Button.favoriteAction.favorite PathIcon">
            <Setter Property="Foreground" Value="#F3C84B" />
        </Style>

        <!-- Затемнение основного интерфейса при открытом модальном окне -->
        <Style Selector="Grid.shellRoot.modalDimmed">
            <Setter Property="Opacity" Value="0.32" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- Модальный фон (Backdrop) под текущую тему -->
        <Style Selector="Border.modalBackdrop">
            <Setter Property="Background" Value="{DynamicResource TriskoModalBackdropBackground}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <!-- Карточка модального окна выбора серверов -->
        <Style Selector="Border.modalCard">
            <Setter Property="Width" Value="860" />
            <Setter Property="MaxWidth" Value="980" />
            <Setter Property="MinHeight" Value="560" />
            <Setter Property="MaxHeight" Value="700" />
            <Setter Property="Margin" Value="24,16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="28,22" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource TriskoCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BoxShadow" Value="0 16 48 0 #60000000" />
        </Style>

        <!-- Кнопка закрытия модального окна (✕) -->
        <Style Selector="Button.modalCloseButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TriskoSecondaryActionBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoSecondaryActionBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.modalCloseButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoSecondaryActionHoverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>

        <!-- Кнопка вызова модального окна "Доступные VPN-серверы" на главном экране -->
        <Style Selector="Button.openServersButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{DynamicResource TriskoSubCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoSubCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.openServersButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TriskoNavHoverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TriskoCardBorderHover}" />
        </Style>
    </UserControl.Styles>

    <ThemeVariantScope x:Name="TriskoThemeScope">
        <Panel Background="{DynamicResource TriskoShellBackground}">
        <Grid Classes="shellRoot" Classes.modalDimmed="{Binding IsAnyModalOpen}" ColumnDefinitions="Auto,*">
        <Border
            Grid.Column="0"
            Classes="sidebar"
            Classes.collapsed="{Binding IsSidebarCollapsed}">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding ToggleShowConnectionNavCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding ShowConnectionNav, Mode=OneWay}" IsHitTestVisible="False" MinWidth="0" Margin="0" Padding="0" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Source="/Assets/Trisko/Icons/connection.png" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.Sab71afb97f2e9ea6}" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding ToggleShowRdpNavCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding ShowRdpNav, Mode=OneWay}" IsHitTestVisible="False" MinWidth="0" Margin="0" Padding="0" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Source="/Assets/Trisko/Icons/rdp.png" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.S23113fd47fe94736}" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding ToggleShowSmbNavCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding ShowSmbNav, Mode=OneWay}" IsHitTestVisible="False" MinWidth="0" Margin="0" Padding="0" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Source="/Assets/Trisko/Icons/folder.png" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.S2f76b507c8dee4f6}" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding ToggleShowSshNavCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding ShowSshNav, Mode=OneWay}" IsHitTestVisible="False" MinWidth="0" Margin="0" Padding="0" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Source="/Assets/Trisko/Icons/ssh.png" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.S7ed2aec1b68bbe00}" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding ToggleShowEcpNavCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding ShowEcpNav, Mode=OneWay}" IsHitTestVisible="False" MinWidth="0" Margin="0" Padding="0" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Source="/Assets/Trisko/Icons/ecp.png" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.S9c960dfb1bb004bc}" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding ToggleShowSettingsNavCommand}">
                        <MenuItem.Icon>
                            <CheckBox IsChecked="{Binding ShowSettingsNav, Mode=OneWay}" IsHitTestVisible="False" MinWidth="0" Margin="0" Padding="0" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Source="/Assets/Trisko/Icons/settings.png" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.S985b5e0f2ccf1ba0}" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{x:Static tr:TriskoStrings.S30ec3cb6881d3fb0}" Command="{Binding ShowAllNavSectionsCommand}">
                        <MenuItem.Icon>
                            <PathIcon Width="14" Height="14" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Border.ContextMenu>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <Grid Margin="14,22,14,18" RowDefinitions="Auto,*,Auto">
                <Grid Margin="0,0,0,24" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsSidebarCollapsed}">
                        <Image
                            Width="36"
                            Height="36"
                            Source="{StaticResource TriskoLogo}"
                            Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock FontSize="18" Classes="brandTitle" FontWeight="Bold" Text="Trisko" />
                            <TextBlock FontSize="9" FontWeight="Bold" Classes="brandSubtitle" LetterSpacing="2.0" Text="CONNECT" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Classes="sidebarToggle"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="{x:Static tr:TriskoStrings.S5613efa512f58228}">
                            <TextBlock FontSize="13" Classes="sectionSubtitle" Text="◀" />
                        </Button>
                    </Grid>
                    <Button
                        HorizontalAlignment="Center"
                        Classes="sidebarToggle"
                        Command="{Binding ToggleSidebarCommand}"
                        ToolTip.Tip="{x:Static tr:TriskoStrings.Sc3246d9e27a926d7}"
                        IsVisible="{Binding IsSidebarCollapsed}">
                        <TextBlock FontSize="13" Classes="sectionSubtitle" Text="▶" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="9">
                    <Button Classes="nav" Command="{Binding OpenGlobalSearchCommand}" ToolTip.Tip="{x:Static tr:TriskoStrings.Sb5dc00a408d251a1}" AutomationProperties.Name="{x:Static tr:TriskoStrings.S37f1f81b74ab6c7d}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <Viewbox Width="23" Height="23" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource SearchMenuIconData}" Stroke="{DynamicResource TriskoNavIconForeground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S180f58ab975323f9}" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="{x:Static tr:TriskoStrings.Sab71afb97f2e9ea6}"
                        Classes="nav"
                        Classes.active="{Binding IsConnectionPage}"
                        Command="{Binding ShowConnectionCommand}"
                        IsVisible="{Binding ShowConnectionNav}"
                        ToolTip.Tip="{x:Static tr:TriskoStrings.Sab71afb97f2e9ea6}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <Image Classes="navIcon" Source="/Assets/Trisko/Icons/connection.png" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.Sab71afb97f2e9ea6}" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="{x:Static tr:TriskoStrings.S7ec5636aaf881c65}"
                        Classes="nav"
                        Classes.active="{Binding IsRemoteDesktopsPage}"
                        Command="{Binding ShowRemoteDesktopsCommand}"
                        IsVisible="{Binding ShowRdpNav}"
                        ToolTip.Tip="{x:Static tr:TriskoStrings.S7ec5636aaf881c65}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <Image Classes="navIcon" Source="/Assets/Trisko/Icons/rdp.png" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S23113fd47fe94736}" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="{x:Static tr:TriskoStrings.S18d1b0f9b0903509}"
                        Classes="nav"
                        Classes.active="{Binding IsFileStoragePage}"
                        Command="{Binding ShowFileStorageCommand}"
                        IsVisible="{Binding ShowSmbNav}"
                        ToolTip.Tip="{x:Static tr:TriskoStrings.S18d1b0f9b0903509}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <Image Classes="navIcon" Source="/Assets/Trisko/Icons/folder.png" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S2f76b507c8dee4f6}" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="{x:Static tr:TriskoStrings.S7ed2aec1b68bbe00}"
                        Classes="nav"
                        Classes.active="{Binding IsSshAccessPage}"
                        Command="{Binding ShowSshAccessCommand}"
                        IsVisible="{Binding ShowSshNav}"
                        ToolTip.Tip="{x:Static tr:TriskoStrings.S7ed2aec1b68bbe00}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <Image Classes="navIcon" Source="/Assets/Trisko/Icons/ssh.png" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S7ed2aec1b68bbe00}" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="{x:Static tr:TriskoStrings.S472fcf5c80866315}"
                        Classes="nav"
                        Classes.active="{Binding IsEcpPage}"
                        Command="{Binding ShowEcpCommand}"
                        IsVisible="{Binding ShowEcpNav}"
                        ToolTip.Tip="{x:Static tr:TriskoStrings.S07f4cfa86f42cf0f}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <Image Classes="navIcon" Source="/Assets/Trisko/Icons/ecp.png" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S9c960dfb1bb004bc}" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="9">
                    <Border Classes="separator" IsVisible="{Binding ShowSettingsNav}" />
                    <Button
                        AutomationProperties.Name="{x:Static tr:TriskoStrings.S985b5e0f2ccf1ba0}"
                        Classes="nav"
                        Classes.active="{Binding IsSettingsPage}"
                        Command="{Binding ShowSettingsCommand}"
                        IsVisible="{Binding ShowSettingsNav}"
                        ToolTip.Tip="{x:Static tr:TriskoStrings.S985b5e0f2ccf1ba0}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <Image Classes="navIcon" Source="/Assets/Trisko/Icons/settings.png" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S985b5e0f2ccf1ba0}" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="{x:Static tr:TriskoStrings.S3a100f9610650ed3}"
                        Classes="nav"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="{Binding ThemeTooltipText}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <Grid Width="23" Height="23">
                                <Image Classes="navIcon" Source="{StaticResource TriskoLogo}" IsVisible="{Binding IsBrandTheme}" />
                                <Image Classes="navIcon" Source="/Assets/Trisko/Icons/theme-dark.png" IsVisible="{Binding IsDarkTheme}" />
                                <Image Classes="navIcon" Source="/Assets/Trisko/Icons/theme-light.png" IsVisible="{Binding IsLightTheme}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center" Text="{Binding ThemeButtonText}" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        Margin="14,0"
                        FontSize="11"
                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                        IsVisible="{Binding !IsSidebarCollapsed}"
                        Text="{Binding ProductVersionText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <!-- Подключение -->
            <Grid Margin="32,24,32,30" RowDefinitions="Auto,*" Background="Transparent" IsVisible="{Binding IsConnectionPage}">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static tr:TriskoStrings.S9c1bea4538a140e8}" ToggleType="CheckBox" IsChecked="{Binding ShowConnectionStatus, Mode=TwoWay}" />
                        <MenuItem Header="{x:Static tr:TriskoStrings.S87d89494d05be655}" ToggleType="CheckBox" IsChecked="{Binding ShowConnectionResources, Mode=TwoWay}" />
                        
                        <MenuItem Header="{x:Static tr:TriskoStrings.Sf67a185fb3e05ded}" ToggleType="CheckBox" IsChecked="{Binding ShowConnectionConfiguration, Mode=TwoWay}" />
                        <MenuItem Header="{x:Static tr:TriskoStrings.S060a65141fe64813}" ToggleType="CheckBox" IsChecked="{Binding ShowConnectionLogs, Mode=TwoWay}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.Sda190d88a98b606b}" TextWrapping="Wrap" />
                        <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.S19f42bdfed6d5e8a}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="36" Height="36" Padding="8" Classes="secondaryAction"
                            Click="OpenCompactConnection_Click" ToolTip.Tip="{x:Static tr:TriskoStrings.S665de243bae1b7c0}">
                        <PathIcon Width="18" Height="18" Data="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3M19 19H5V5H19V19M11 11H17V17H11V11Z" />
                    </Button>
                </Grid>

                <ScrollViewer x:Name="ConnectionScrollViewer" Grid.Row="1" Margin="0,24,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <deskgek:TriskoAdaptivePairPanel Breakpoint="920" Spacing="20" PrimaryFraction="0.6" SecondaryAutoWidth="False" FillHeight="True" MinHeight="{Binding #ConnectionScrollViewer.Viewport.Height}">
                    <!-- Левая колонка: Блок подключения + Блок доступных серверов -->
                    <deskgek:TriskoStretchStackPanel Spacing="14" VerticalAlignment="Stretch">
                        <Border Classes="card" Padding="12,10" VerticalAlignment="Top" IsVisible="{Binding ShowConnectionStatus}">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
                                <StackPanel Spacing="4" ToolTip.Tip="{Binding StateTitle}">
                                    <TextBlock Text="VPN" FontSize="11" FontWeight="SemiBold" Classes="sectionSubtitle" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ConnectionStatusBadge}" Foreground="{Binding StatusColor}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" ToolTip.Tip="{Binding AnyDeskNetworkStatusText}">
                                    <TextBlock Text="AnyDesk" FontSize="11" FontWeight="SemiBold" Classes="sectionSubtitle" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OverviewAnyDeskText}" Foreground="{Binding AnyDeskNetworkStatusColor}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" ToolTip.Tip="{Binding EcpStatusText}">
                                    <TextBlock Text="VirtualHere" FontSize="11" FontWeight="SemiBold" Classes="sectionSubtitle" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OverviewVirtualHereText}" Foreground="{Binding OverviewVirtualHereColor}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                
                                
                            </Grid>
                        </Border>
                        <!-- Карточка 1: Основная карточка подключения (занимает всю доступную высоту) -->
                        <Border
                            Padding="28,24"
                            VerticalAlignment="Stretch"
                            Classes="card">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <!-- Верхний статус и описание -->
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                            <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" />
                                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="{Binding StatusColor}" Text="{Binding ConnectionStatusBadge}" />
                                        </StackPanel>
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Classes="cardTitle" Text="{Binding StateTitle}" TextAlignment="Center" />
                                        <TextBlock
                                            MaxWidth="540"
                                            FontSize="14"
                                            Classes="cardSubtitle"
                                            Text="{Binding StateDescription}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Живая кнопка подключения: волны, органическая форма и стабильный кликабельный центр. -->
                                    <StackPanel Grid.Row="1" Margin="0,14" HorizontalAlignment="Center" Spacing="4">
                                        <Grid Width="244" Height="244">
                                            <deskgek:TriskoConnectingOrb
                                                AccentColor="{Binding StatusColor}"
                                                StateKey="{Binding ConnectionStatusBadge}"
                                                IsIdle="{Binding IsConnectionIdle}"
                                                IsAnimationEnabled="{Binding IsConnectionPage}" />
                                            <Button
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding ConnectionButtonText}"
                                                Classes="powerAction"
                                                Command="{Binding RunPrimaryActionCommand}"
                                                IsEnabled="{Binding CanRunPrimaryAction}">
                                                <!-- Прозрачный фон растягивает hit-test на всю площадь кнопки. -->
                                                <Grid Background="Transparent">
                                                    <StackPanel
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="7">
                                                        <!-- Вектор из on-button-svgrepo-com.svg: не зависит от наличия Unicode-глифа ⏻ в Windows 10. -->
                                                        <Viewbox Width="56" Height="56" HorizontalAlignment="Center" Stretch="Uniform">
                                                            <Canvas Width="24" Height="24">
                                                                <Path
                                                                    Data="M10.5 6.57575C10.5 6.39592 10.5 6.30601 10.438 6.2611C10.376 6.21618 10.2935 6.24325 10.1285 6.29738C7.73122 7.08369 6 9.33953 6 11.9997C6 15.3134 8.68629 17.9997 12 17.9997C15.3137 17.9997 18 15.3134 18 11.9997C18 9.33953 16.2688 7.08369 13.8715 6.29738C13.7065 6.24325 13.624 6.21618 13.562 6.2611C13.5 6.30601 13.5 6.39592 13.5 6.57575V8.99977C13.5 9.8282 12.8284 10.4998 12 10.4998C11.1716 10.4998 10.5 9.8282 10.5 8.99977V6.57575Z"
                                                                    Fill="White"
                                                                    Opacity="0.22" />
                                                                <Path
                                                                    Data="M12 9L12 4"
                                                                    Stroke="White"
                                                                    StrokeLineCap="Round"
                                                                    StrokeThickness="1.5" />
                                                                <Path
                                                                    Data="M18.0104 5.98959C19.1992 7.17834 20.0087 8.69289 20.3367 10.3417C20.6646 11.9906 20.4963 13.6996 19.853 15.2528C19.2096 16.806 18.1202 18.1335 16.7223 19.0675C15.3245 20.0015 13.6811 20.5 12 20.5C10.3189 20.5 8.67547 20.0015 7.27765 19.0675C5.87984 18.1335 4.79037 16.806 4.14702 15.2528C3.50368 13.6996 3.33535 11.9906 3.66332 10.3417C3.9913 8.69289 4.80085 7.17834 5.98959 5.98959"
                                                                    Stroke="White"
                                                                    StrokeLineCap="Round"
                                                                    StrokeThickness="1.5" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock
                                                            MaxWidth="130"
                                                            HorizontalAlignment="Center"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding ConnectionButtonText}"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Grid>

                                        <Border
                                            HorizontalAlignment="Center"
                                            Classes="connectionDurationBadge"
                                            IsVisible="{Binding IsConnected}">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                                    Text="{x:Static tr:TriskoStrings.Sba1a5b02aa36ded5}" />
                                                <TextBlock
                                                    FontFamily="Cascadia Mono, Consolas"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding StatusColor}"
                                                    Text="{Binding ConnectionDurationText}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Островок: Выбранный профиль по центру, справа кнопка Проверить пинг -->
                                    <StackPanel Grid.Row="2" Spacing="16">
                                        <StackPanel Spacing="8" IsVisible="{Binding IsReconnectPending}">
                                            <TextBlock Text="{Binding ReconnectCountdownText}" TextWrapping="Wrap" TextAlignment="Center"
                                                       FontSize="12" Classes="sectionSubtitle" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                                <Button Classes="secondaryAction" Content="{x:Static tr:TriskoStrings.S7a4f6595b5ed6fd4}" Command="{Binding RetryConnectionNowCommand}" />
                                                <Button Classes="secondaryAction" Content="{x:Static tr:TriskoStrings.S7c47f7292ba4f2ae}" Command="{Binding CancelReconnectCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <deskgek:TriskoAdaptivePairPanel Breakpoint="620" Spacing="12">
                                            <!-- Островок выбранного профиля -->
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                            <Border
                                                Grid.Row="1"
                                                Padding="14,8"
                                                Classes="subCard"
                                                Classes.connectedProfile="{Binding IsConnected}"
                                                CornerRadius="20"
                                                ToolTip.Tip="{Binding VpnProfileSelectionHint}">
                                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        Fill="{Binding StatusColor}"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsConnected}" />
                                                    <PathIcon
                                                        Grid.Column="1"
                                                        Width="14"
                                                        Height="14"
                                                        VerticalAlignment="Center"
                                                        Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                                                        Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                                                        IsVisible="{Binding !IsConnected}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TriskoSubCardValueForeground}"
                                                        Text="{Binding SelectedVpnDisplayName}"
                                                        ToolTip.Tip="{Binding SelectedVpnDisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                                    <WrapPanel Margin="14,0,0,0">
                                                    <Border
                                                        Margin="2,0,0,0"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource TriskoCardBackground}"
                                                        IsVisible="{Binding SelectedVpnProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                                                            Text="{Binding EffectiveVpnProfile.ProtocolName}" />
                                                    </Border>
                                                    <!-- Бейдж пинга выбранного профиля -->
                                                    <Border
                                                        Margin="2,0,0,0"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource TriskoCardBackground}"
                                                        IsVisible="{Binding SelectedVpnProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <Panel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding EffectiveVpnProfile.IsTesting}" VerticalAlignment="Center">
                                                                <Ellipse Width="4" Height="4" Classes="pingDot pingDot1" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                                <Ellipse Width="4" Height="4" Classes="pingDot pingDot2" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                                <Ellipse Width="4" Height="4" Classes="pingDot pingDot3" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{Binding EffectiveVpnProfile.DelayColor}"
                                                                Text="{Binding EffectiveVpnProfile.DelayText}"
                                                                IsVisible="{Binding !EffectiveVpnProfile.IsTesting}" />
                                                        </Panel>
                                                    </Border>
                                                    </WrapPanel>
                                            </Grid>

                                            <!-- Кнопка "Проверить пинг" справа от профиля -->
                                            <Button
                                                VerticalAlignment="Bottom"
                                                Classes="secondaryAction"
                                                Command="{Binding TestLatencyCommand}"
                                                IsEnabled="{Binding CanTestLatency}"
                                                Padding="14,8"
                                                CornerRadius="16"
                                                ToolTip.Tip="{Binding LatencyStatusText}">
                                                <Panel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsLatencyTestBusy}" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                            <Ellipse Width="4" Height="4" Classes="pingDot pingDot1" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                            <Ellipse Width="4" Height="4" Classes="pingDot pingDot2" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                            <Ellipse Width="4" Height="4" Classes="pingDot pingDot3" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                        </StackPanel>
                                                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{x:Static tr:TriskoStrings.S638f8008a1733349}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsLatencyTestBusy}" VerticalAlignment="Center">
                                                        <PathIcon Width="12" Height="12" Data="M13 2L3 14h7v8l10-12h-7z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{x:Static tr:TriskoStrings.Sfd2ccf3a4291152c}" />
                                                    </StackPanel>
                                                </Panel>
                                            </Button>
                                        </deskgek:TriskoAdaptivePairPanel>

                                        <!-- Выбранный адаптер в самом низу по центру таким же шрифтом, без фона -->
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Classes="sectionSubtitle"
                                            Text="{Binding EffectiveNetworkInterfaceText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        <!-- Карточка 2: Выбор серверов -->
                        <Border Padding="20,16" VerticalAlignment="Bottom" Classes="card">
                                <StackPanel Spacing="12">
                                    <!-- Верхняя плашка блока: Заголовок + кол-во серверов + аккуратная стильная кнопка "Выбрать сервер" -->
                                    <deskgek:TriskoAdaptivePairPanel Breakpoint="540" Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                            <PathIcon Width="16" Height="16" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold" Classes="cardTitle" Text="{x:Static tr:TriskoStrings.S9055aad2972fdbec}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Border
                                                Grid.Column="2"
                                                Margin="4,0,0,0"
                                                Padding="7,2"
                                                CornerRadius="6"
                                                Background="{DynamicResource TriskoSubCardBackground}"
                                                BorderBrush="{DynamicResource TriskoSubCardBorder}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding RegularVpnProfileCount}" />
                                            </Border>
                                        </Grid>

                                        <!-- Аккуратная и стильная кнопка вызова модального окна -->
                                        <Button
                                            Classes="secondaryAction"
                                            Command="{Binding OpenVpnServersModalCommand}"
                                            IsVisible="{Binding HasVpnProfiles}"
                                            Padding="14,8"
                                            CornerRadius="10"
                                            ToolTip.Tip="{x:Static tr:TriskoStrings.S8452ea120e845387}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Static tr:TriskoStrings.Sa6fbf704ac15697e}" VerticalAlignment="Center" />
                                                <PathIcon Width="10" Height="10" Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </deskgek:TriskoAdaptivePairPanel>

                                    <Border Padding="18" Classes="subCard" IsVisible="{Binding !HasVpnProfiles}">
                                        <StackPanel Spacing="12">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static tr:TriskoStrings.EmptyVpnTitle}" />
                                            <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.EmptyVpnDescription}" TextWrapping="Wrap" />
                                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                                <Button Classes="primaryAction" Command="{Binding AddManualVpnCommand}" Content="{x:Static tr:TriskoStrings.AddVpnLink}" />
                                                <Button Classes="secondaryAction" Command="{Binding ConfigureVpnSubscriptionCommand}" Content="{x:Static tr:TriskoStrings.AddSubscription}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Карточка выбранного подключения в развернутом виде (как в списке) -->
                                    <Border
                                        Padding="12,10"
                                        CornerRadius="10"
                                        Classes="subCard"
                                        Classes.connectedProfile="{Binding IsConnected}"
                                        IsVisible="{Binding HasVpnProfiles}"
                                        ToolTip.Tip="{Binding VpnProfileSelectionHint}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinHeight="44">
                                            <!-- Иконка типа подключения -->
                                            <Border
                                                Grid.Column="0"
                                                Classes="profileIconBorder"
                                                Width="34"
                                                Height="34"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TriskoCardBackground}"
                                                BorderBrush="{DynamicResource TriskoCardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <PathIcon
                                                        Width="15"
                                                        Height="15"
                                                        IsVisible="{Binding EffectiveVpnProfile.IsAutomatic}"
                                                        Data="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.9 17.55 11 21 11 21z"
                                                        Foreground="#4F8CFF" />
                                                    <PathIcon
                                                        Width="15"
                                                        Height="15"
                                                        IsVisible="{Binding !EffectiveVpnProfile.IsAutomatic}"
                                                        Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                                                        Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                </Panel>
                                            </Border>

                                            <!-- Информация о сервере -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        FontSize="13"
                                                        Foreground="{DynamicResource TriskoCardTitleForeground}"
                                                        MaxLines="1"
                                                        Text="{Binding SelectedVpnDisplayName}"
                                                        ToolTip.Tip="{Binding SelectedVpnDisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                <WrapPanel>
                                                    <Border
                                                        Margin="0,0,8,4"
                                                        Padding="5,1"
                                                        CornerRadius="5"
                                                        Background="{DynamicResource TriskoCardBackground}"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding EffectiveVpnProfile.ProtocolName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                                                            Text="{Binding EffectiveVpnProfile.ProtocolName}" />
                                                    </Border>
                                                    <!-- Бейдж активного профиля -->
                                                    <Border
                                                        Padding="6,1.5"
                                                        CornerRadius="5"
                                                        Background="{DynamicResource TriskoNavActiveBackground}"
                                                        BorderBrush="{DynamicResource TriskoCardBorderHover}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <PathIcon Width="8" Height="8" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Foreground="{DynamicResource TriskoCardBorderHover}" />
                                                            <TextBlock
                                                                FontSize="9"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource TriskoCardBorderHover}"
                                                                Text="{x:Static tr:TriskoStrings.S0435a1722c022fd6}"
                                                                VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                                        Text="{Binding EffectiveVpnProfile.DetailsText}"
                                                        IsVisible="{Binding EffectiveVpnProfile.GroupName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                                        Text="{Binding EffectiveVpnProfile.EndpointText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Пинг и кнопка спидометра -->
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                                <Border
                                                    VerticalAlignment="Center"
                                                    Padding="8,4"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource TriskoCardBackground}"
                                                    BorderBrush="{DynamicResource TriskoCardBorder}"
                                                    BorderThickness="1"
                                                    MinWidth="70">
                                                    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Spacing="3"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding EffectiveVpnProfile.IsTesting}">
                                                            <Ellipse Width="4.5" Height="4.5" Classes="pingDot pingDot1" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                            <Ellipse Width="4.5" Height="4.5" Classes="pingDot pingDot2" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                            <Ellipse Width="4.5" Height="4.5" Classes="pingDot pingDot3" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding EffectiveVpnProfile.DelayColor}"
                                                            Text="{Binding EffectiveVpnProfile.DelayText}"
                                                            IsVisible="{Binding !EffectiveVpnProfile.IsTesting}" />
                                                    </Panel>
                                                </Border>

                                                <!-- Кнопка проверки пинга (спидометр) -->
                                                <Button
                                                    Classes="rowSpeedometerButton"
                                                    Command="{Binding TestLatencyCommand}"
                                                    IsEnabled="{Binding CanTestLatency}"
                                                    ToolTip.Tip="{x:Static tr:TriskoStrings.S43c0b13efd24fbaa}">
                                                    <PathIcon
                                                        Width="13"
                                                        Height="13"
                                                        Data="M12 3a9 9 0 0 0-9 9c0 2.6 1.1 4.9 2.9 6.5l1.4-1.4A7 7 0 0 1 5 12a7 7 0 1 1 14 0c0 1.9-.8 3.7-2.1 5l1.4 1.4c2-1.7 3.2-4.1 3.2-6.9a9 9 0 0 0-9-9zm-1 4v5.2l3.2 3.2 1.4-1.4-2.6-2.6V7h-2z"
                                                        Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                        </Border>
                        <Border Padding="15,12" Classes="errorBox" VerticalAlignment="Top"
                                IsVisible="{Binding FailureMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="errorText" Text="{Binding FailureMessage}" TextWrapping="Wrap" />
                        </Border>
                    </deskgek:TriskoStretchStackPanel>

                    <deskgek:TriskoStretchStackPanel Spacing="14" VerticalAlignment="Stretch" IsVisible="{Binding HasConnectionSideBlocks}">
                        <Border Padding="20" Classes="card" IsVisible="{Binding ShowConnectionResources}">
                            <StackPanel Spacing="11">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S87d89494d05be655}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding Resources.Count}" />
                                </Grid>
                                <TextBlock FontSize="13" Classes="sectionSubtitle" Text="{Binding ResourceSummaryText}" TextWrapping="Wrap" />
                                <Border Classes="separator" />
                                <Grid ColumnDefinitions="*,8,*,8,*">
                                    <Button Grid.Column="0" Classes="quickCard" Command="{Binding ShowRemoteDesktopsCommand}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="7">
                                            <Image Width="27" Height="27" Source="/Assets/Trisko/Icons/rdp.png" />
                                            <TextBlock FontSize="12" Text="RDP" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="quickCard" Command="{Binding ShowFileStorageCommand}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="7">
                                            <Image Width="27" Height="27" Source="/Assets/Trisko/Icons/folder.png" />
                                            <TextBlock FontSize="12" Text="{x:Static tr:TriskoStrings.S9088ca9c0de94ffd}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="4" Classes="quickCard" Command="{Binding ShowSshAccessCommand}" IsVisible="{Binding ShowSshNav}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="7">
                                            <Image Width="27" Height="27" Source="/Assets/Trisko/Icons/ssh.png" />
                                            <TextBlock FontSize="12" Text="SSH" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Разблокировка сервисов -->
                        

                        <Border Padding="20" Classes="card" IsVisible="{Binding ShowConnectionConfiguration}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontSize="16" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sf67a185fb3e05ded}" VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Classes="secondaryAction"
                                        Command="{Binding ShowFormatHelpCommand}"
                                        ToolTip.Tip="{x:Static tr:TriskoStrings.S2ce20e80ac987c63}">
                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                                <TextBlock FontSize="12" Classes="sectionSubtitle" Text="{Binding ConfigurationStatus}" TextWrapping="Wrap" />
                                <deskgek:TriskoResponsiveGridPanel MinItemWidth="150" Spacing="8">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Classes="secondaryAction"
                                        Command="{Binding ImportCorporateConfigurationCommand}"
                                        Content="{x:Static tr:TriskoStrings.Sd0422edc0ad49cfd}"
                                        IsEnabled="{Binding !IsConfigurationBusy}"
                                        ToolTip.Tip="{x:Static tr:TriskoStrings.S5d44b1ff8e7a4598}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Classes="secondaryAction"
                                        Command="{Binding ExportCorporateConfigurationCommand}"
                                        Content="{x:Static tr:TriskoStrings.Sdf87c5932684e3e8}"
                                        IsEnabled="{Binding !IsConfigurationBusy}"
                                        ToolTip.Tip="{x:Static tr:TriskoStrings.S96080c489c53acc1}" />
                                </deskgek:TriskoResponsiveGridPanel>
                            </StackPanel>
                        </Border>

                        <Border Padding="18,16" Classes="card" VerticalAlignment="Stretch" MinHeight="220" deskgek:TriskoStretchStackPanel.NaturalHeightLimit="400" IsVisible="{Binding ShowConnectionLogs}">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontSize="16" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sb3bee7c775f79580}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{Binding StartupDiagnosticsColor}"
                                            Text="{Binding StartupDiagnosticsTitle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,5,0,9"
                                    FontSize="11"
                                    Foreground="{DynamicResource TriskoSubCardLabelForeground}"
                                    MaxLines="3"
                                    Text="{Binding StartupDiagnosticsMessage}"
                                    TextWrapping="Wrap" />
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding ConnectionLogEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gek:TriskoConnectionLogEntry">
                                                <Grid Margin="0,4" ColumnDefinitions="Auto,9,*">
                                                    <TextBlock
                                                        VerticalAlignment="Top"
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                                        Text="{Binding TimeText}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        FontSize="11"
                                                        Foreground="{Binding Color}"
                                                        Text="{Binding Message}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                    </deskgek:TriskoStretchStackPanel>
                </deskgek:TriskoAdaptivePairPanel>
                </ScrollViewer>
            </Grid>

            <!-- Удалённый доступ -->
            <Grid Margin="32,24,32,30" RowDefinitions="Auto,*" IsVisible="{Binding IsRemoteDesktopsPage}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.S7ec5636aaf881c65}" TextWrapping="Wrap" />
                        <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.S2c578e1d69691518}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="secondaryAction" Content="{x:Static tr:TriskoStrings.S682554aad26a4b9f}" VerticalAlignment="Center"
                            Click="RemoteSections_Click" AutomationProperties.Name="{x:Static tr:TriskoStrings.Sa6817432c405aef9}" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="RemoteLayoutFeedback" Classes="sectionSubtitle" TextWrapping="Wrap"
                                   IsVisible="{Binding #RemoteLayoutFeedback.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock x:Name="RemoteSectionsEmpty" Classes="sectionSubtitle" IsVisible="False" TextWrapping="Wrap"
                                   Text="{x:Static tr:TriskoStrings.S4b124087f2df3846}" />

                        <Border x:Name="RdpCard" Classes="remoteDesktopCard">
                            <Expander Classes="remoteDesktopMethod" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="sectionTitle" Text="RDP" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S567c156dfc0af260}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Classes="remoteDesktopBody">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBox
                                            VerticalAlignment="Center"
                                            Classes="searchBox"
                                            PlaceholderText="{x:Static tr:TriskoStrings.S696de6647be92fdb}"
                                            Text="{Binding RdpSearchQuery, Mode=TwoWay}">
                                            <TextBox.InnerLeftContent>
                                                <PathIcon Width="14" Height="14" Margin="10,0,6,0" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" />
                                            </TextBox.InnerLeftContent>
                                            <TextBox.InnerRightContent>
                                                <Button
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,6,0"
                                                    Padding="0"
                                                    Classes="clearSearchButton"
                                                    Command="{Binding ClearRdpSearchCommand}"
                                                    IsVisible="{Binding RdpSearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    ToolTip.Tip="{x:Static tr:TriskoStrings.S6e1f7baa472fcfbb}">
                                                    <PathIcon Width="10" Height="10" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" />
                                                </Button>
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                        <Button Grid.Column="1" Classes="primaryAction" Command="{Binding AddRdpResourceCommand}" Content="{x:Static tr:TriskoStrings.S943d795e3b07c4a1}" />
                                        <Button Grid.Column="2" Classes="secondaryAction" Content="{x:Static tr:TriskoStrings.S985b5e0f2ccf1ba0}" Click="RdpSettings_Click"
                                                AutomationProperties.Name="{x:Static tr:TriskoStrings.S23e9d16eaea0d215}" />
                                    </Grid>
                                    <StackPanel Spacing="16" IsVisible="{Binding HasRemoteDesktopResources}">
                                        <!-- Pinned Section -->
                                        <StackPanel Spacing="10" IsVisible="{Binding HasPinnedRemoteDesktopResources}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <PathIcon Width="12" Height="12" Data="M505.743,157.097L354.895,6.249c-8.331-8.331-21.839-8.331-30.17,0L264.395,66.58c-8.331,8.331-8.331,21.839,0,30.17 l15.075,15.075L168.712,222.583C121.131,199.863,62.432,208.2,23.04,247.612c-8.328,8.332-8.326,21.836,0.004,30.166 l90.531,90.531c-0.219,0.201-0.448,0.384-0.66,0.596L6.248,475.572c-8.331,8.331-8.331,21.839,0,30.17 c8.331,8.331,21.839,8.331,30.17,0l106.667-106.667c0.212-0.212,0.395-0.441,0.596-0.66l90.541,90.541 c8.331,8.331,21.839,8.331,30.17,0c39.415-39.415,47.747-98.116,25.014-145.694l110.75-110.75l15.086,15.086 c8.331,8.331,21.839,8.331,30.17,0l60.331-60.331C514.074,178.936,514.074,165.429,505.743,157.097z M247.408,441.802 L70.196,264.59c32.716-19.33,75.573-14.935,103.696,13.188l60.331,60.331C262.346,366.233,266.742,409.078,247.408,441.802z M264.393,307.937l-60.347-60.347l105.594-105.594l60.347,60.348L264.393,307.937z M430.328,202.343l-15.065-15.065 c-0.007-0.007-0.013-0.015-0.02-0.022l-90.517-90.517c-0.007-0.007-0.015-0.013-0.022-0.02l-15.054-15.054l30.161-30.161 l120.678,120.678L430.328,202.343z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{x:Static tr:TriskoStrings.S7b4269825916f1aa}" />
                                            </StackPanel>
                                            <ItemsControl ItemTemplate="{StaticResource ResourceCardTemplate}" ItemsSource="{Binding PinnedRemoteDesktopResources}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <deskgek:TriskoResponsiveGridPanel MinItemWidth="300" Spacing="16" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Unpinned Section -->
                                        <StackPanel Spacing="10" IsVisible="{Binding HasUnpinnedRemoteDesktopResources}">
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{x:Static tr:TriskoStrings.Sdf97dd3ba9584c30}" IsVisible="{Binding HasPinnedRemoteDesktopResources}" />
                                            <ItemsControl ItemTemplate="{StaticResource ResourceCardTemplate}" ItemsSource="{Binding UnpinnedRemoteDesktopResources}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <deskgek:TriskoResponsiveGridPanel MinItemWidth="300" Spacing="16" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Padding="28" Classes="card" IsVisible="{Binding HasNoRemoteDesktopResources}" VerticalAlignment="Top">
                                        <StackPanel Spacing="8">
                                            <TextBlock FontSize="19" Classes="sectionTitle" Text="{Binding RdpEmptyTitle}" />
                                            <TextBlock Classes="sectionSubtitle" Text="{Binding RdpEmptySubtitle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Border x:Name="VncCard" Classes="remoteDesktopCard">
                            <Expander Classes="remoteDesktopMethod">
                                <Expander.Header>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="sectionTitle" Text="VNC" />
                                        <TextBlock Classes="sectionSubtitle" Text="{Binding #VncPanel.StatusText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Classes="remoteDesktopBody">
                                    <deskgek:TriskoVncPanel x:Name="VncPanel" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Panel x:Name="AnyDeskAvailability" IsVisible="{Binding IsAnyDeskIntegrationEnabled}">
                            <Border x:Name="AnyDeskCard" Classes="remoteDesktopCard">
                                <Expander x:Name="AnyDeskSection" Classes="remoteDesktopMethod">
                                    <Expander.Header>
                                        <StackPanel Spacing="3">
                                            <WrapPanel ItemSpacing="10" LineSpacing="3">
                                                <TextBlock Classes="sectionTitle" Text="AnyDesk" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <Border Width="7" Height="7" CornerRadius="4" Background="{Binding AnyDeskNetworkStatusColor}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="sectionSubtitle" Text="{Binding OverviewAnyDeskText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </WrapPanel>
                                            <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Scc87ef20ed7c63c7}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Classes="remoteDesktopBody">
                                        <WrapPanel ItemSpacing="12" LineSpacing="6">
                                            <RadioButton GroupName="AnyDeskViewMode" IsChecked="{Binding IsAnyDeskIntegrationView, Mode=OneWay}"
                                                         Command="{Binding ShowAnyDeskIntegrationViewCommand}" Content="{x:Static tr:TriskoStrings.S4b742c6c367a8306}" />
                                            <RadioButton GroupName="AnyDeskViewMode" IsChecked="{Binding IsEmbeddedAnyDeskView, Mode=OneWay}"
                                                         Command="{Binding ShowEmbeddedAnyDeskViewCommand}" Content="{x:Static tr:TriskoStrings.Sd346cff923d15add}" />
                                        </WrapPanel>
                                        <WrapPanel ItemSpacing="8" LineSpacing="4" IsVisible="{Binding IsAnyDeskIntegrationView}">
                                            <TextBlock Classes="sectionSubtitle" VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.Saa42dbd7c0c71490}" />
                                            <SelectableTextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding AnyDeskWorkstationAddressText}" />
                                        </WrapPanel>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsAnyDeskIntegrationView}">
                                            <TextBox Classes="remoteInput" PlaceholderText="{x:Static tr:TriskoStrings.S66e984e720cc0a52}" Text="{Binding AnyDeskManualAddress, Mode=TwoWay}" />
                                            <Button Grid.Column="1" Classes="primaryAction" Command="{Binding ConnectManualAnyDeskCommand}" Content="{x:Static tr:TriskoStrings.S36b4c0b07f08c596}" />
                                            <Button Grid.Column="2" Classes="secondaryAction" Content="{x:Static tr:TriskoStrings.S985b5e0f2ccf1ba0}" Click="AnyDeskSettings_Click"
                                                    AutomationProperties.Name="{x:Static tr:TriskoStrings.S8dc07a7bb029948a}" />
                                        </Grid>
                                        <StackPanel Spacing="12" IsVisible="{Binding IsAnyDeskIntegrationView}">
                                            <TextBlock Classes="sectionSubtitle" Text="{Binding AnyDeskActionStatus}" TextWrapping="Wrap"
                                                       IsVisible="{Binding AnyDeskActionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <ItemsControl ItemTemplate="{StaticResource AnyDeskConnectionTemplate}" ItemsSource="{Binding AnyDeskConnections}" IsVisible="{Binding HasAnyDeskConnections}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <deskgek:TriskoResponsiveGridPanel MinItemWidth="300" Spacing="16" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <Border Padding="22" Classes="card" IsVisible="{Binding HasNoAnyDeskConnections}">
                                                <StackPanel Spacing="6">
                                                    <TextBlock FontSize="16" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Saef644bbb273e8a2}" />
                                                    <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S35149cebd0834ecd}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsEmbeddedAnyDeskView}">
                                            <Button Classes="secondaryAction" Content="{x:Static tr:TriskoStrings.S985b5e0f2ccf1ba0}" Click="AnyDeskSettings_Click"
                                                    AutomationProperties.Name="{x:Static tr:TriskoStrings.S8dc07a7bb029948a}" />
                                            <Button Classes="primaryAction" Content="{x:Static tr:TriskoStrings.S10818ec5a4cad749}" Click="AnyDeskFullscreenButton_Click"
                                                    IsEnabled="{Binding IsAnyDeskEmbeddedWindowAttached}" />
                                        </WrapPanel>
                                        <Border Height="640" Padding="1" Classes="card" ClipToBounds="True" IsVisible="{Binding IsEmbeddedAnyDeskView}">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                    <TextBlock HorizontalAlignment="Center" FontSize="16" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S399e809ab4800ca4}" />
                                                    <TextBlock MaxWidth="520" TextAlignment="Center" Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S86c2b7c8b50ada77}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <deskgek:TriskoAnyDeskNativeHost x:Name="EmbeddedAnyDeskHost"
                                                    ExecutablePath="{Binding EffectiveAnyDeskExecutablePath}"
                                                    IsActive="{Binding IsEmbeddedAnyDeskActive}"
                                                    IsWindowAttached="{Binding IsAnyDeskEmbeddedWindowAttached, Mode=TwoWay}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </Panel>
                        <ContentControl x:Name="AnyDeskSettingsSlot" IsVisible="False">
                            <StackPanel Spacing="14">
                                    
                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <Button Classes="triskoSecondary" Command="{Binding RefreshAnyDeskCommand}" Content="{x:Static tr:TriskoStrings.S163a016f3df71adc}" />
                                    <Button Classes="triskoSecondary" Click="OpenAdvancedAnyDeskSettings_Click" Content="{x:Static tr:TriskoStrings.Sdf99e3164cc5cc7c}" />
                                </WrapPanel>
                                <!-- Предупреждения и статусы под строкой -->
                                

                                <Border Padding="14,10" Background="#18F0717E" BorderBrush="#88F0717E" BorderThickness="1" CornerRadius="8" IsVisible="{Binding HasAnyDeskEnvironmentWarning}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <PathIcon Width="16" Height="16" VerticalAlignment="Center" Data="M12 2L1 21h22L12 2zm0 3.45L20.53 19H3.47L12 5.45zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z" Foreground="#F0717E" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TriskoCardTitleForeground}" Text="{Binding AnyDeskEnvironmentWarningText}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                
                                
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Файлы -->
            <Grid Margin="32,24,32,30" RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsFileStoragePage}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.S18d1b0f9b0903509}" />
                        <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.S15a1955cbec8e73d}" />
                    </StackPanel>
                    <TextBox
                        Grid.Column="1"
                        Width="240"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Classes="searchBox"
                        PlaceholderText="{x:Static tr:TriskoStrings.S95dba9a83702a233}"
                        Text="{Binding FileStorageSearchQuery, Mode=TwoWay}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Width="14" Height="14" Margin="10,0,6,0" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Button
                                Width="24"
                                Height="24"
                                Margin="0,0,6,0"
                                Padding="0"
                                Classes="clearSearchButton"
                                Command="{Binding ClearFileStorageSearchCommand}"
                                IsVisible="{Binding FileStorageSearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                ToolTip.Tip="{x:Static tr:TriskoStrings.S6e1f7baa472fcfbb}">
                                <PathIcon Width="10" Height="10" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button Classes="primaryAction" Command="{Binding AddSmbResourceCommand}" Content="{x:Static tr:TriskoStrings.Sa7ed234cb2d8c9d8}" />
                        <Button Classes="secondaryAction" Command="{Binding ImportCorporateConfigurationCommand}" Content="{x:Static tr:TriskoStrings.Sd91478251da603a1}" />
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            Classes="secondaryAction"
                            Command="{Binding ShowFormatHelpCommand}"
                            ToolTip.Tip="{x:Static tr:TriskoStrings.S2ce20e80ac987c63}">
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border
                    Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="14,11"
                    Classes="errorBox"
                    IsVisible="{Binding FailureMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Classes="errorText" Text="{Binding FailureMessage}" TextWrapping="Wrap" />
                </Border>
                <ScrollViewer Grid.Row="2" Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel Spacing="16" IsVisible="{Binding HasFileStorageResources}">
                            <!-- Pinned Section -->
                            <StackPanel Spacing="10" IsVisible="{Binding HasPinnedFileStorageResources}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="12" Height="12" Data="M505.743,157.097L354.895,6.249c-8.331-8.331-21.839-8.331-30.17,0L264.395,66.58c-8.331,8.331-8.331,21.839,0,30.17 l15.075,15.075L168.712,222.583C121.131,199.863,62.432,208.2,23.04,247.612c-8.328,8.332-8.326,21.836,0.004,30.166 l90.531,90.531c-0.219,0.201-0.448,0.384-0.66,0.596L6.248,475.572c-8.331,8.331-8.331,21.839,0,30.17 c8.331,8.331,21.839,8.331,30.17,0l106.667-106.667c0.212-0.212,0.395-0.441,0.596-0.66l90.541,90.541 c8.331,8.331,21.839,8.331,30.17,0c39.415-39.415,47.747-98.116,25.014-145.694l110.75-110.75l15.086,15.086 c8.331,8.331,21.839,8.331,30.17,0l60.331-60.331C514.074,178.936,514.074,165.429,505.743,157.097z M247.408,441.802 L70.196,264.59c32.716-19.33,75.573-14.935,103.696,13.188l60.331,60.331C262.346,366.233,266.742,409.078,247.408,441.802z M264.393,307.937l-60.347-60.347l105.594-105.594l60.347,60.348L264.393,307.937z M430.328,202.343l-15.065-15.065 c-0.007-0.007-0.013-0.015-0.02-0.022l-90.517-90.517c-0.007-0.007-0.015-0.013-0.022-0.02l-15.054-15.054l30.161-30.161 l120.678,120.678L430.328,202.343z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{x:Static tr:TriskoStrings.S7b4269825916f1aa}" />
                                </StackPanel>
                                <ItemsControl ItemTemplate="{StaticResource ResourceCardTemplate}" ItemsSource="{Binding PinnedFileStorageResources}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <deskgek:TriskoResponsiveGridPanel MinItemWidth="300" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Unpinned Section -->
                            <StackPanel Spacing="10" IsVisible="{Binding HasUnpinnedFileStorageResources}">
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{x:Static tr:TriskoStrings.Sdf97dd3ba9584c30}" IsVisible="{Binding HasPinnedFileStorageResources}" />
                                <ItemsControl ItemTemplate="{StaticResource ResourceCardTemplate}" ItemsSource="{Binding UnpinnedFileStorageResources}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <deskgek:TriskoResponsiveGridPanel MinItemWidth="300" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <Border Padding="28" Classes="card" IsVisible="{Binding HasNoFileStorageResources}" VerticalAlignment="Top">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="19" Classes="sectionTitle" Text="{Binding FileStorageEmptyTitle}" />
                                <TextBlock Classes="sectionSubtitle" Text="{Binding FileStorageEmptySubtitle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- SSH -->
            <Grid Margin="32,24,32,30" RowDefinitions="Auto,*" IsVisible="{Binding IsSshAccessPage}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.S7ed2aec1b68bbe00}" />
                        <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.S7436994976b9de91}" />
                    </StackPanel>
                    <TextBox
                        Grid.Column="1"
                        Width="240"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Classes="searchBox"
                        PlaceholderText="{x:Static tr:TriskoStrings.S5b77ab8dc7b04b17}"
                        Text="{Binding SshSearchQuery, Mode=TwoWay}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Width="14" Height="14" Margin="10,0,6,0" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Button
                                Width="24"
                                Height="24"
                                Margin="0,0,6,0"
                                Padding="0"
                                Classes="clearSearchButton"
                                Command="{Binding ClearSshSearchCommand}"
                                IsVisible="{Binding SshSearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                ToolTip.Tip="{x:Static tr:TriskoStrings.S6e1f7baa472fcfbb}">
                                <PathIcon Width="10" Height="10" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button Classes="primaryAction" Command="{Binding AddSshResourceCommand}" Content="{x:Static tr:TriskoStrings.S42f65083b858a687}" />
                        <Button Classes="secondaryAction" Command="{Binding ImportCorporateConfigurationCommand}" Content="{x:Static tr:TriskoStrings.Sd91478251da603a1}" />
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            Classes="secondaryAction"
                            Command="{Binding ShowFormatHelpCommand}"
                            ToolTip.Tip="{x:Static tr:TriskoStrings.S2ce20e80ac987c63}">
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,24,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel Spacing="16" IsVisible="{Binding HasSshResources}">
                            <!-- Pinned Section -->
                            <StackPanel Spacing="10" IsVisible="{Binding HasPinnedSshResources}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="12" Height="12" Data="M505.743,157.097L354.895,6.249c-8.331-8.331-21.839-8.331-30.17,0L264.395,66.58c-8.331,8.331-8.331,21.839,0,30.17 l15.075,15.075L168.712,222.583C121.131,199.863,62.432,208.2,23.04,247.612c-8.328,8.332-8.326,21.836,0.004,30.166 l90.531,90.531c-0.219,0.201-0.448,0.384-0.66,0.596L6.248,475.572c-8.331,8.331-8.331,21.839,0,30.17 c8.331,8.331,21.839,8.331,30.17,0l106.667-106.667c0.212-0.212,0.395-0.441,0.596-0.66l90.541,90.541 c8.331,8.331,21.839,8.331,30.17,0c39.415-39.415,47.747-98.116,25.014-145.694l110.75-110.75l15.086,15.086 c8.331,8.331,21.839,8.331,30.17,0l60.331-60.331C514.074,178.936,514.074,165.429,505.743,157.097z M247.408,441.802 L70.196,264.59c32.716-19.33,75.573-14.935,103.696,13.188l60.331,60.331C262.346,366.233,266.742,409.078,247.408,441.802z M264.393,307.937l-60.347-60.347l105.594-105.594l60.347,60.348L264.393,307.937z M430.328,202.343l-15.065-15.065 c-0.007-0.007-0.013-0.015-0.02-0.022l-90.517-90.517c-0.007-0.007-0.015-0.013-0.022-0.02l-15.054-15.054l30.161-30.161 l120.678,120.678L430.328,202.343z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{x:Static tr:TriskoStrings.S7b4269825916f1aa}" />
                                </StackPanel>
                                <ItemsControl ItemTemplate="{StaticResource ResourceCardTemplate}" ItemsSource="{Binding PinnedSshResources}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <deskgek:TriskoResponsiveGridPanel MinItemWidth="300" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Unpinned Section -->
                            <StackPanel Spacing="10" IsVisible="{Binding HasUnpinnedSshResources}">
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{x:Static tr:TriskoStrings.Sdf97dd3ba9584c30}" IsVisible="{Binding HasPinnedSshResources}" />
                                <ItemsControl ItemTemplate="{StaticResource ResourceCardTemplate}" ItemsSource="{Binding UnpinnedSshResources}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <deskgek:TriskoResponsiveGridPanel MinItemWidth="300" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <Border Padding="28" Classes="card" IsVisible="{Binding HasNoSshResources}" VerticalAlignment="Top">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="19" Classes="sectionTitle" Text="{Binding SshEmptyTitle}" />
                                <TextBlock Classes="sectionSubtitle" Text="{Binding SshEmptySubtitle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Электронная цифровая подпись -->
            <Grid Margin="32,24,32,30" RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsEcpPage}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.S472fcf5c80866315}" />
                        <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.S59ba2f3e1ae59e20}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button Classes="primaryAction" Command="{Binding StartVirtualHereCommand}" Content="{x:Static tr:TriskoStrings.Sf1470450f7ea4ca5}" IsEnabled="{Binding !IsEcpBusy}" IsVisible="{Binding !IsVirtualHereRunning}" />
                        <Button Classes="primaryAction" Command="{Binding RefreshEcpDevicesCommand}" Content="{x:Static tr:TriskoStrings.S603e460bf59cac0f}" IsEnabled="{Binding !IsEcpBusy}" IsVisible="{Binding IsVirtualHereRunning}" ToolTip.Tip="{x:Static tr:TriskoStrings.Sfd56f1cfe88c2cd7}" />
                        <Button Classes="secondaryAction" Command="{Binding ScanEcpDevicesCommand}" Content="{x:Static tr:TriskoStrings.S75168b402337248a}" IsEnabled="{Binding !IsEcpBusy}" IsVisible="{Binding IsVirtualHereRunning}" ToolTip.Tip="{x:Static tr:TriskoStrings.Sf2ffdb1b636373b9}" />
                        <!-- <Button Classes="secondaryAction" Command="{Binding OpenVirtualHereCommand}" Content="{x:Static tr:TriskoStrings.S4fa2e331604515eb}" /> -->
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,18,0,0" Spacing="10">
                    <Border Padding="14,11" Classes="subCard">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <PathIcon Width="16" Height="16" Data="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2m1 15h-2v-6h2zm0-8h-2V7h2z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="cardSubtitle" Text="{Binding EcpStatusText}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <Border Padding="14,11" Classes="errorBox" IsVisible="{Binding EcpFailureMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="errorText" Text="{Binding EcpFailureMessage}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" Margin="0,18,0,0" Padding="28" Classes="card" IsVisible="{Binding !IsVirtualHereRunning}" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="19" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Saff12c1ec2e0e7a5}" />
                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Sa4d21dde4ff01730}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" Margin="0,18,0,0" IsVisible="{Binding IsVirtualHereRunning}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl ItemTemplate="{StaticResource EcpDeviceCardTemplate}" ItemsSource="{Binding EcpDevices}" IsVisible="{Binding HasEcpDevices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <deskgek:TriskoResponsiveGridPanel MinItemWidth="310" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Padding="28" Classes="card" IsVisible="{Binding HasNoEcpDevices}" VerticalAlignment="Top">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="19" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sfb60742527deb73d}" />
                                <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S985dd3c71c8cabb3}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Настройки -->
            <!-- Настройки -->
            <Grid Margin="32,24,32,30" IsVisible="{Binding IsSettingsPage}">

                <!-- 1. Главная страница настроек -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSettingsMainSubPage}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.S985b5e0f2ccf1ba0}" />
                        <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.Sc38008cced8a7f85}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,24,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Корпоративный комплект -->
                            <Border Padding="22" Classes="card">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <PathIcon Width="20" Height="20" Data="M9 8h1.5v4.44L20.97 1.97l1.06 1.06L11.56 13.5H16V15h-5.75C9.56 15 9 14.44 9 13.75zm8.75 11c.69 0 1.25-.56 1.25-1.25V11.5h1.5v6.25a2.755 2.755 0 0 1-2.75 2.75H6.25a2.755 2.755 0 0 1-2.75-2.75V6.25A2.755 2.755 0 0 1 6.25 3.5h6.25V5H6.25C5.56 5 5 5.56 5 6.25v11.5c0 .69.56 1.25 1.25 1.25z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="17,0" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S46c436069efb05f8}" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Saf3293d68adbc678}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{Binding ConfigurationStatus}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Classes="primaryAction"
                                            Command="{Binding ImportCorporateConfigurationCommand}"
                                            IsEnabled="{Binding !IsConfigurationBusy}"
                                            ToolTip.Tip="{x:Static tr:TriskoStrings.S0e0a6dc82ef64556}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <PathIcon Width="13" Height="13" Data="M11.625 15.513q-.175-.063-.325-.213l-3.6-3.6q-.3-.3-.288-.7t.288-.7q.3-.3.713-.312t.712.287L11 12.15V5q0-.425.288-.712T12 4t.713.288T13 5v7.15l1.875-1.875q.3-.3.713-.288t.712.313q.275.3.288.7t-.288.7l-3.6 3.6q-.15.15-.325.213t-.375.062t-.375-.062M6 20q-.825 0-1.412-.587T4 18v-2q0-.425.288-.712T5 15t.713.288T6 16v2h12v-2q0-.425.288-.712T19 15t.713.288T20 16v2q0 .825-.587 1.413T18 20z" />
                                                <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.Sd0422edc0ad49cfd}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Classes="secondaryAction"
                                            Command="{Binding ExportCorporateConfigurationCommand}"
                                            IsEnabled="{Binding !IsConfigurationBusy}"
                                            ToolTip.Tip="{x:Static tr:TriskoStrings.S0a206f6d2e0aa4dc}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <PathIcon Width="13" Height="13" Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Foreground="{DynamicResource TriskoCardTitleForeground}" />
                                                <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.Sd2ab5a1bb6394a4b}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Width="36"
                                            Height="36"
                                            Padding="0"
                                            Classes="secondaryAction"
                                            Command="{Binding ShowFormatHelpCommand}"
                                            ToolTip.Tip="{x:Static tr:TriskoStrings.S2ce20e80ac987c63}">
                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Подписка и локальные ресурсы -->
                            <Border Padding="22" Classes="card">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <PathIcon Width="20" Height="20" Data="m10 17.55l-1.77 1.72a2.47 2.47 0 0 1-3.5-3.5l4.54-4.55a2.46 2.46 0 0 1 3.39-.09l.12.1a1 1 0 0 0 1.4-1.43a3 3 0 0 0-.18-.21a4.46 4.46 0 0 0-6.09.22l-4.6 4.55a4.48 4.48 0 0 0 6.33 6.33L11.37 19A1 1 0 0 0 10 17.55M20.69 3.31a4.49 4.49 0 0 0-6.33 0L12.63 5A1 1 0 0 0 14 6.45l1.73-1.72a2.47 2.47 0 0 1 3.5 3.5l-4.54 4.55a2.46 2.46 0 0 1-3.39.09l-.12-.1a1 1 0 0 0-1.4 1.43a3 3 0 0 0 .23.21a4.47 4.47 0 0 0 6.09-.22l4.55-4.55a4.49 4.49 0 0 0 .04-6.33" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="17,0" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Saa005266d6a298b7}" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Saccc8dc8cc368d4c}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{Binding VpnSubscriptionStatus}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid Grid.Column="2" VerticalAlignment="Center" RowDefinitions="Auto,8,Auto" ColumnDefinitions="*,7,*,7,*" MinWidth="210">
                                        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="primaryAction" Command="{Binding ConfigureVpnSubscriptionCommand}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                                <PathIcon Width="14" Height="14" Data="m10 17.55l-1.77 1.72a2.47 2.47 0 0 1-3.5-3.5l4.54-4.55a2.46 2.46 0 0 1 3.39-.09l.12.1a1 1 0 0 0 1.4-1.43a3 3 0 0 0-.18-.21a4.46 4.46 0 0 0-6.09.22l-4.6 4.55a4.48 4.48 0 0 0 6.33 6.33L11.37 19A1 1 0 0 0 10 17.55M20.69 3.31a4.49 4.49 0 0 0-6.33 0L12.63 5A1 1 0 0 0 14 6.45l1.73-1.72a2.47 2.47 0 0 1 3.5 3.5l-4.54 4.55a2.46 2.46 0 0 1-3.39.09l-.12-.1a1 1 0 0 0-1.4 1.43a3 3 0 0 0 .23.21a4.47 4.47 0 0 0 6.09-.22l4.55-4.55a4.49 4.49 0 0 0 .04-6.33" />
                                                <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.Se788c66398697917}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8" Classes="secondaryAction" Command="{Binding AddRdpResourceCommand}" Content="RDP" />
                                        <Button Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8" Classes="secondaryAction" Command="{Binding AddSshResourceCommand}" Content="SSH" />
                                        <Button Grid.Row="2" Grid.Column="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8" Classes="secondaryAction" Command="{Binding AddSmbResourceCommand}" Content="SMB" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Classes="card" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S621aa897131d433c}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="secondaryAction" Command="{Binding AddManualVpnCommand}" Content="{x:Static tr:TriskoStrings.S512a7c81896059a1}" />
                                        <Button Classes="secondaryAction" Command="{Binding ConfigureVpnSubscriptionCommand}" Content="{x:Static tr:TriskoStrings.Se788c66398697917}" />
                                        <Button Classes="secondaryAction" Command="{Binding UpdateVpnSubscriptionCommand}" Content="{x:Static tr:TriskoStrings.S8c39a63e9772874e}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Subscriptions}" IsEnabled="{Binding !IsVpnSubscriptionBusy}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gek:TriskoSubscriptionItem">
                                                <Border Classes="subCard" Padding="12" Margin="0,4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Host}" Classes="sectionSubtitle" />
                                                            <ContentControl Content="{Binding Usage}" ContentTemplate="{StaticResource SubscriptionUsageTemplate}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Classes="secondaryAction" Command="{Binding EditCommand}" Content="{x:Static tr:TriskoStrings.Sb8b151d4174391f0}" />
                                                            <Button Classes="secondaryAction" Command="{Binding UpdateCommand}" Content="{x:Static tr:TriskoStrings.S603e460bf59cac0f}" />
                                                            <Button Classes="secondaryAction" Command="{Binding DeleteCommand}" Content="{x:Static tr:TriskoStrings.Sbe99b13612015a48}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="18">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S9089a73112cc819e}" />
                                    <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" MinWidth="240">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="gek:TriskoLanguageOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Sc219fc987a483f5b}" />
                                    <TextBlock Text="{Binding LanguageStatus}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S2e70c6968f0abb44}" />

                            <!-- 1C Category Button -->
                            <Button Classes="settingCategoryCard" Command="{Binding NavigateToOneCSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <PathIcon Width="20" Height="20" Data="M12 2C7.58 2 4 3.79 4 6v12c0 2.21 3.58 4 8 4s8-1.79 8-4V6c0-2.21-3.58-4-8-4m0 2c3.87 0 6 1.5 6 2s-2.13 2-6 2s-6-1.5-6-2s2.13-2 6-2M6 8.71C7.47 9.5 9.61 10 12 10s4.53-.5 6-1.29V12c0 .5-2.13 2-6 2s-6-1.5-6-2zm0 6C7.47 15.5 9.61 16 12 16s4.53-.5 6-1.29V18c0 .5-2.13 2-6 2s-6-1.5-6-2z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="16" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sf172d9978dd14ad9}" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Saa8393d628a5cc51}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{Binding OneCSystemStatusColor}" Text="{Binding OneCSettingsSummaryText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                                        <Border
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TriskoSubCardBackground}"
                                            BorderBrush="{Binding OneCSystemStatusColor}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="7" Height="7" VerticalAlignment="Center" Background="{Binding OneCSystemStatusColor}" CornerRadius="3.5" />
                                                <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{Binding OneCSystemStatusColor}" Text="{Binding OneCSystemStatusTitle}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" VerticalAlignment="Center" Text="›" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Routing Category Button -->
                            <Button Classes="settingCategoryCard" Command="{Binding NavigateToVpnRoutingSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <PathIcon Width="20" Height="20" Data="M4 6h5v2H6v3h12V8h-3V6h5v7H4zm7-4h2v6h3l-4 4-4-4h3zm-5 13h12v5H6zm2 2v1h8v-1z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="16" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S63dbc39dfc4e2210}" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Sf4af5f7c0135fd68}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding VpnRoutingSummaryText, StringFormat={x:Static tr:TriskoStrings.S90c008c0722d3ea2}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" VerticalAlignment="Center" Text="›" />
                                </Grid>
                            </Button>

                            <!-- Automation & Workflow Category Button -->
                            <Button Classes="settingCategoryCard" Command="{Binding NavigateToSmbAutomationSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <PathIcon Width="20" Height="20" Data="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.9 17.55 11 21 11 21z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="16" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sf5b1345ebed84b1e}" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S6d18d62f6e50f3aa}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding SmbAutomationSummaryText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" VerticalAlignment="Center" Text="›" />
                                </Grid>
                            </Button>

                            <!-- Network Interface Category Button -->
                            <Button Classes="settingCategoryCard" Command="{Binding NavigateToNetworkInterfaceSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <PathIcon Width="20" Height="20" Data="M4 6.5v3a.5.5 0 1 1-1 0v-3a.5.5 0 1 1 1 0M6.5 6a.5.5 0 0 0-.5.5v3a.5.5 0 1 0 1 0v-3a.5.5 0 0 0-.5-.5m3 0a.5.5 0 0 0-.5.5v3a.5.5 0 1 0 1 0v-3a.5.5 0 0 0-.5-.5m3 0a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 1 0v-3a.5.5 0 0 0-.5-.5m2.5-.5v5a1.5 1.5 0 0 1-1.5 1.5H13v1.5a.5.5 0 0 1-.5.5h-6a.5.5 0 0 1-.5-.5V12H2v1.5a.5.5 0 0 1-1 0V3H.5a.5.5 0 0 1 0-1H1a1 1 0 0 1 1 1v1h11.5A1.5 1.5 0 0 1 15 5.5M7 13h2v-1H7zm5-1h-2v1h2zm2-6.5a.5.5 0 0 0-.5-.5H2v6h11.5a.5.5 0 0 0 .5-.5z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="16" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S91f9d8f84334c90b}" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Se890745b4e26e92e}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding NetworkInterfaceSummaryText, StringFormat={x:Static tr:TriskoStrings.S7dd9b939e3a49326}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" VerticalAlignment="Center" Text="›" />
                                </Grid>
                            </Button>

                            <!-- VirtualHere servers Category Button -->
                            <Button Classes="settingCategoryCard" Command="{Binding NavigateToEcpServerSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <Image Width="20" Height="20" Source="/Assets/Trisko/Icons/ecp.png" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="16" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S52533e3aba82f5f5}" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Sa26ad7746e2d7d9a}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding EcpServerSettingsSummaryText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" VerticalAlignment="Center" Text="›" />
                                </Grid>
                            </Button>

                            <!-- AnyDesk integration Category Button -->
                            <Button Classes="settingCategoryCard" Command="{Binding NavigateToAnyDeskSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <PathIcon Width="20" Height="20" Data="M0 12 7 5l7 7-7 7z M11 5h6l7 7-7 7h-6l7-7z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontSize="16" Classes="sectionTitle" Text="AnyDesk" />
                                            <Border Padding="6,1" Background="{DynamicResource TriskoNavActiveBackground}" BorderBrush="{DynamicResource TriskoCardBorderHover}" BorderThickness="1" CornerRadius="5">
                                                <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TriskoCardBorderHover}" Text="6.1.0 PORTABLE" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S2579c3f0c21dde03}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding AnyDeskIntegrationSummaryText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" VerticalAlignment="Center" Text="›" />
                                </Grid>
                            </Button>

                            <!-- Service bypass category -->
                            

                            <!-- Updates Category Button -->
                            <Button Classes="settingCategoryCard" Command="{Binding NavigateToUpdatesSettingsCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <PathIcon Width="20" Height="20" Data="M12 21q-1.875 0-3.512-.712t-2.85-1.925t-1.925-2.85T3 12t.713-3.512t1.924-2.85t2.85-1.925T12 3q2.05 0 3.888.875T19 6.35V5q0-.425.288-.712T20 4t.713.288T21 5v4q0 .425-.288.713T20 10h-4q-.425 0-.712-.288T15 9t.288-.712T16 8h1.75q-1.025-1.4-2.525-2.2T12 5Q9.075 5 7.038 7.038T5 12t2.038 4.963T12 19q2.375 0 4.25-1.425t2.475-3.675q.125-.4.45-.6t.725-.15q.425.05.675.362t.15.688q-.725 2.975-3.15 4.888T12 21m1-9.4l2.5 2.5q.275.275.275.7t-.275.7t-.7.275t-.7-.275l-2.8-2.8q-.15-.15-.225-.337T11 11.975V8q0-.425.288-.712T12 7t.713.288T13 8z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="16" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S1eb91e3a5236a9cf}" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Saa393ffdd50c9cad}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding UpdatesSummaryText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" VerticalAlignment="Center" Text="›" />
                                </Grid>
                            </Button>

                            <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Se792813166d37ecf}" />

                            <!-- Тема оформления -->
                            <Border Padding="22" Classes="card">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <Grid Width="22" Height="22">
                                            <Image Source="{StaticResource TriskoLogo}" IsVisible="{Binding IsBrandTheme}" />
                                            <Image Source="/Assets/Trisko/Icons/theme-dark.png" IsVisible="{Binding IsDarkTheme}" />
                                            <Image Source="/Assets/Trisko/Icons/theme-light.png" IsVisible="{Binding IsLightTheme}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="17,0" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sbe8dc4f53d3f52b3}" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Sedd378c90fb0a830}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding ThemeSummaryText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Classes.primaryAction="{Binding IsBrandTheme}"
                                            Classes.secondaryAction="{Binding !IsBrandTheme}"
                                            Command="{Binding SelectBrandThemeCommand}"
                                            ToolTip.Tip="{x:Static tr:TriskoStrings.Sb87f14a9c28a792f}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Image Width="16" Height="16" Source="{StaticResource TriskoLogo}" />
                                                <TextBlock VerticalAlignment="Center" Text="Trisko" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Classes.primaryAction="{Binding IsDarkTheme}"
                                            Classes.secondaryAction="{Binding !IsDarkTheme}"
                                            Command="{Binding SelectDarkThemeCommand}"
                                            ToolTip.Tip="{x:Static tr:TriskoStrings.S91938c4f36b2e63a}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Image Width="16" Height="16" Source="/Assets/Trisko/Icons/theme-dark.png" />
                                                <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S1eecfcaa7bdb1269}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Classes.primaryAction="{Binding IsLightTheme}"
                                            Classes.secondaryAction="{Binding !IsLightTheme}"
                                            Command="{Binding SelectLightThemeCommand}"
                                            ToolTip.Tip="{x:Static tr:TriskoStrings.Sdb51ef1a37b706a5}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Image Width="16" Height="16" Source="/Assets/Trisko/Icons/theme-light.png" />
                                                <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.Sf0cd3a6033724d44}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Расширенные настройки v2rayN -->
                            <Border Padding="22" Classes="card">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <PathIcon Width="20" Height="20" Data="M4.848 16.62V0H2.91v16.62a3.879 3.879 0 1 0 1.94 0 M16.485 6.924V0h-1.94v6.924a3.879 3.879 0 1 0 1.94 0 M28.121 16.62V0h-1.94v16.62a3.879 3.879 0 1 0 1.94 0" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="17,0" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S9a17a9073500159f}" />
                                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S286c9ae3e7737dab}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{x:Static tr:TriskoStrings.Sa12e83e0f2f1841b}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Classes="secondaryAction"
                                        Command="{Binding ShowAdvancedVpnSettingsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Width="14" Height="14" Data="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4m-8-2l8-8m0 0v5m0-5h-5" Classes="sectionSubtitle" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S17d5d1cc2766a222}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border
                                Padding="15,12"
                                Classes="errorBox"
                                IsVisible="{Binding FailureMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Classes="errorText" Text="{Binding FailureMessage}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 2. Подстраница: Настройка 1С -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSettingsOneCSubPage}">
                    <StackPanel Spacing="12">
                        <Button HorizontalAlignment="Left" Classes="backNav" Command="{Binding NavigateToSettingsMainCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="←" VerticalAlignment="Center" FontWeight="Bold" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.Sddbf139caa44f171}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.Sf172d9978dd14ad9}" />
                            <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.Sdec48d25b3b8b513}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S9b34c21abc8d7e21}" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="11,6"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource TriskoSubCardBackground}"
                                            BorderBrush="{Binding OneCSystemStatusColor}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Border
                                                    Width="8"
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding OneCSystemStatusColor}"
                                                    CornerRadius="4" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding OneCSystemStatusColor}"
                                                    Text="{Binding OneCSystemStatusTitle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,16,*">
                                        <StackPanel Spacing="6">
                                            <TextBlock FontSize="13" Foreground="{DynamicResource TriskoSubCardLabelForeground}" Text="{x:Static tr:TriskoStrings.Sa25bf1f64e15301a}" />
                                            <TextBox
                                                IsEnabled="{Binding !IsOneCSystemBusy}"
                                                MaxLength="253"
                                                PlaceholderText="triskodata"
                                                Text="{Binding OneCServerName, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock FontSize="13" Foreground="{DynamicResource TriskoSubCardLabelForeground}" Text="{x:Static tr:TriskoStrings.S22750a94deb7b420}" />
                                            <TextBox
                                                IsEnabled="{Binding !IsOneCSystemBusy}"
                                                MaxLength="15"
                                                PlaceholderText="192.168.3.222"
                                                Text="{Binding OneCServerAddress, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{Binding OneCSystemStatusColor}"
                                        Text="{Binding OneCSystemStatusMessage}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        Text="{Binding OneCRouteText}"
                                        TextWrapping="Wrap" />

                                    <Border
                                        Padding="14,12"
                                        Background="{DynamicResource TriskoSubCardBackground}"
                                        BorderBrush="{DynamicResource TriskoSubCardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        IsVisible="{Binding HasOneCHostsEntries}">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TriskoSubCardLabelForeground}"
                                                Text="{x:Static tr:TriskoStrings.S6e2a0099e8ab9f2a}" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{DynamicResource TriskoSubCardValueForeground}"
                                                Text="{Binding OneCHostsEntriesText}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                        <Button
                                            Classes="primaryAction"
                                            Command="{Binding ConfigureOneCSystemCommand}"
                                            IsEnabled="{Binding !IsOneCSystemBusy}"
                                            Content="{x:Static tr:TriskoStrings.S535f157f37eef377}" />
                                        <Button
                                            Classes="secondaryAction"
                                            Command="{Binding RefreshOneCSystemCommand}"
                                            IsEnabled="{Binding !IsOneCSystemBusy}"
                                            Content="{x:Static tr:TriskoStrings.Se4424a6df6f657f8}" />
                                        <Button
                                            Classes="dangerAction"
                                            Command="{Binding RemoveOneCSystemCommand}"
                                            IsEnabled="{Binding !IsOneCSystemBusy}"
                                            IsVisible="{Binding IsOneCConfigured}"
                                            Content="{x:Static tr:TriskoStrings.S09f592151b47eb34}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Padding="20" Classes="subCard">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" FontSize="14" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S2f527c6029df61aa}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        Text="{Binding OneCHostsFilePath, StringFormat={x:Static tr:TriskoStrings.Sa31c6cce87563921}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        Text="{x:Static tr:TriskoStrings.Seb17429eb1c00fef}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. Подстраница: Маршрутизация через VPN -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSettingsRoutingSubPage}">
                    <StackPanel Spacing="12">
                        <Button HorizontalAlignment="Left" Classes="backNav" Command="{Binding NavigateToSettingsMainCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="←" VerticalAlignment="Center" FontWeight="Bold" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.Sddbf139caa44f171}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.S63dbc39dfc4e2210}" />
                            <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.Sa42c1b3c12f6dc29}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Card: Режим маршрутизации -->
                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S149e5e2eab249d36}" />
                                    <ComboBox
                                        MinWidth="480"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding CanEditVpnRouting}"
                                        ItemsSource="{Binding VpnRoutingModeOptions}"
                                        SelectedItem="{Binding SelectedVpnRoutingModeOption}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="gek:TriskoVpnRoutingModeOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        Text="{Binding SelectedVpnRoutingModeOption.Description}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Classes="primaryAction"
                                        Command="{Binding SaveVpnRoutingModeCommand}"
                                        IsEnabled="{Binding CanEditVpnRouting}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Width="14" Height="14" Data="M4 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1V9.5A1.5 1.5 0 0 1 5.5 8h5A1.5 1.5 0 0 1 12 9.5V13a1 1 0 0 0 1-1V5.621a1 1 0 0 0-.293-.707l-1.621-1.621A1 1 0 0 0 10.379 3H10v1.5A1.5 1.5 0 0 1 8.5 6h-2A1.5 1.5 0 0 1 5 4.5V3zm2 0v1.5a.5.5 0 0 0 .5.5h2a.5.5 0 0 0 .5-.5V3zm5 10V9.5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0-.5.5V13z" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S6a3ac168fb2fa71f}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Card: Дополнительные IP и сети -->
                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sb3b6a35bcac9c39f}" />
                                    <TextBlock
                                        Classes="sectionSubtitle"
                                        Text="{x:Static tr:TriskoStrings.Saca21b571282dc8a}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,12,Auto">
                                        <TextBox
                                            IsEnabled="{Binding CanEditVpnRouting}"
                                            Text="{Binding NewManualVpnRoute, Mode=TwoWay}"
                                            PlaceholderText="{x:Static tr:TriskoStrings.S3d44e2def13e83c3}" />
                                        <Button
                                            Grid.Column="2"
                                            Classes="secondaryAction"
                                            Command="{Binding AddManualVpnRouteCommand}"
                                            IsEnabled="{Binding CanEditVpnRouting}"
                                            Content="{x:Static tr:TriskoStrings.S71038c53bbc48d3b}" />
                                    </Grid>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                                        Text="{Binding VpnRoutingSettingStatus}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        IsVisible="{Binding HasNoManualVpnRoutes}"
                                        Text="{x:Static tr:TriskoStrings.Sf06de185d68e4fba}" />
                                    <ItemsControl ItemsSource="{Binding ManualVpnRoutes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gek:TriskoVpnRouteItemViewModel">
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="14,10"
                                                    Background="{DynamicResource TriskoSubCardBackground}"
                                                    BorderBrush="{DynamicResource TriskoSubCardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TriskoSubCardValueForeground}" Text="{Binding Route}" />
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource TriskoSubCardLabelForeground}" Text="{Binding KindText}" />
                                                        </StackPanel>
                                                        <Button
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Classes="dangerAction"
                                                            Command="{Binding RemoveCommand}"
                                                            Content="{x:Static tr:TriskoStrings.Sbe99b13612015a48}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Padding="18" Classes="subCard">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                    Text="{x:Static tr:TriskoStrings.S5ef6da998878b5bc}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 4. Подстраница: Автоматизация и автозапуск ресурсов -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSettingsSmbSubPage}">
                    <StackPanel Spacing="12">
                        <Button HorizontalAlignment="Left" Classes="backNav" Command="{Binding NavigateToSettingsMainCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="←" VerticalAlignment="Center" FontWeight="Bold" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.Sddbf139caa44f171}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.Sf5b1345ebed84b1e}" />
                            <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.S60268d5cceae8fef}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S8ed839274d711129}" />
                                    <StackPanel Spacing="12" IsEnabled="{Binding !IsSavingStartupSettings}">
                                        <CheckBox Content="{x:Static tr:TriskoStrings.S810f7494ef7edd64}"
                                                  IsVisible="{Binding CanConfigureRunAtLogin}"
                                                  IsChecked="{Binding RunAtLogin, Mode=TwoWay}" />
                                        <CheckBox Content="{x:Static tr:TriskoStrings.S4bbb4203d62d68d8}"
                                                  IsChecked="{Binding AutoConnectVpnOnStartup, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Card: Автозапуск рабочих ресурсов -->
                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S88033ecaf2b7fc33}" />
                                    <CheckBox
                                        Content="{x:Static tr:TriskoStrings.S170a45b2467b1136}"
                                        IsChecked="{Binding AutoLaunchResourcesOnVpn, Mode=TwoWay}" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        Text="{x:Static tr:TriskoStrings.S325868ad713ba077}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card: Сетевые диски SMB -->
                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S74a780f5d25a05d6}" />
                                    <CheckBox
                                        Content="{x:Static tr:TriskoStrings.Sa6c792fddae2b1a6}"
                                        IsChecked="{Binding AutoConnectSmbOnVpn, Mode=TwoWay}" />
                                    <CheckBox
                                        Content="{x:Static tr:TriskoStrings.S1ab2241a4b8d3fe6}"
                                        IsChecked="{Binding AutoDisconnectSmbOnVpn, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Card: Описание работы службы -->
                            <Border Padding="20" Classes="subCard">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" FontSize="14" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Scd1e9cc8c7dfe6e2}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        Text="{x:Static tr:TriskoStrings.S5b070dbdf0025af7}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        Text="{x:Static tr:TriskoStrings.Sa88a403fafcbe0ca}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        Text="{x:Static tr:TriskoStrings.S181cb397795fb418}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 5. Подстраница: Сетевой адаптер -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSettingsNetworkSubPage}">
                    <StackPanel Spacing="12">
                        <Button HorizontalAlignment="Left" Classes="backNav" Command="{Binding NavigateToSettingsMainCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="←" VerticalAlignment="Center" FontWeight="Bold" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.Sddbf139caa44f171}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.S91f9d8f84334c90b}" />
                            <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.Se890745b4e26e92e}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sc4f1eebfd0021930}" />
                                    <TextBlock
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        Text="{x:Static tr:TriskoStrings.S023a2d82daa2d654}"
                                        TextWrapping="Wrap" />
                                    <ComboBox
                                        MinWidth="440"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding CanEditNetworkInterface}"
                                        ItemsSource="{Binding NetworkInterfaceOptions}"
                                        SelectedItem="{Binding SelectedNetworkInterfaceOption}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="gek:TriskoNetworkInterfaceOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{Binding EffectiveNetworkInterfaceText}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="13" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding NetworkInterfaceSettingStatus}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                        <Button
                                            Classes="primaryAction"
                                            Command="{Binding SaveNetworkInterfaceCommand}"
                                            IsEnabled="{Binding CanEditNetworkInterface}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Width="14" Height="14" Data="M4 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1V9.5A1.5 1.5 0 0 1 5.5 8h5A1.5 1.5 0 0 1 12 9.5V13a1 1 0 0 0 1-1V5.621a1 1 0 0 0-.293-.707l-1.621-1.621A1 1 0 0 0 10.379 3H10v1.5A1.5 1.5 0 0 1 8.5 6h-2A1.5 1.5 0 0 1 5 4.5V3zm2 0v1.5a.5.5 0 0 0 .5.5h2a.5.5 0 0 0 .5-.5V3zm5 10V9.5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0-.5.5V13zM2 4a2 2 0 0 1 2-2h6.379a2 2 0 0 1 1.414.586l1.621 1.621A2 2 0 0 1 14 5.621V12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z" />
                                                <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S725561b6a89ec1a1}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Classes="secondaryAction"
                                            Command="{Binding RefreshNetworkInterfacesCommand}"
                                            IsEnabled="{Binding CanEditNetworkInterface}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Width="14" Height="14" Data="M20 11A8.1 8.1 0 0 0 4.5 9M4 5v4h4m-4 4a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" Classes="sectionSubtitle" />
                                                <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S163a016f3df71adc}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Padding="18" Classes="subCard">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                    Text="{x:Static tr:TriskoStrings.S5aea1867a62cd092}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 6. Подстраница: серверы ЭЦП -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSettingsEcpServersSubPage}">
                    <StackPanel Spacing="12">
                        <Button HorizontalAlignment="Left" Classes="backNav" Command="{Binding NavigateToSettingsMainCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="←" VerticalAlignment="Center" FontWeight="Bold" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.Sddbf139caa44f171}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.S52533e3aba82f5f5}" />
                            <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.S58c8695b5a3482d3}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="12">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S851897ed4ba9c967}" />
                                    <CheckBox
                                        Content="{x:Static tr:TriskoStrings.S7e4b4657ea1ea09b}"
                                        IsChecked="{Binding AutoStartVirtualHereOnLaunch, Mode=TwoWay}" />
                                    <TextBlock
                                        Classes="sectionSubtitle"
                                        Text="{x:Static tr:TriskoStrings.Secbae64154602432}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                                        Text="{Binding AutoStartVirtualHereSettingStatus}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Scd6e0af7886f5ca6}" />
                                    <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S18bddbf931f58d0b}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="14">
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="{x:Static tr:TriskoStrings.S2c49dd3d3c38c38e}"
                                            IsChecked="{Binding IsEcpAutoScanEnabled, Mode=TwoWay}" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                            <TextBox
                                                HorizontalContentAlignment="Center"
                                                PlaceholderText="5"
                                                Text="{Binding EcpAutoScanIntervalText, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S46a81a92e59e6d10}" />
                                        </Grid>
                                        <Button
                                            Grid.Column="2"
                                            Classes="primaryAction"
                                            Command="{Binding SaveEcpAutoScanSettingsCommand}"
                                            Content="{x:Static tr:TriskoStrings.Sb4d30cae52894cf0}" />
                                    </Grid>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding EcpAutoScanSettingsStatus}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="12">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sd3e233d17b0e189f}" />
                                    <CheckBox
                                        Content="{x:Static tr:TriskoStrings.S362f94d690189b88}"
                                        IsChecked="{Binding RouteEcpServersThroughVpn, Mode=TwoWay}" />
                                    <TextBlock
                                        Classes="sectionSubtitle"
                                        Text="{x:Static tr:TriskoStrings.S2baf17075866fd58}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Margin="22,2,0,2" Spacing="8" IsEnabled="{Binding RouteEcpServersThroughVpn}">
                                        <CheckBox
                                            Content="{x:Static tr:TriskoStrings.S01e1b636b68550e7}"
                                            IsChecked="{Binding RouteEcpInCorporateOnly, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="{x:Static tr:TriskoStrings.S6a9174a62b9f361d}"
                                            IsChecked="{Binding RouteEcpInRussianSites, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="{x:Static tr:TriskoStrings.S3f6b159016ac0179}"
                                            IsChecked="{Binding RouteEcpInGlobalExceptLocal, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="{x:Static tr:TriskoStrings.Se69a8fb48eb50be0}"
                                            IsChecked="{Binding RouteEcpInGlobal, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock
                                        Classes="sectionSubtitle"
                                        Text="{x:Static tr:TriskoStrings.S712f2a90b85ebc41}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                                        Text="{Binding EcpRoutingSettingStatus}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sfd516702e9916c0c}" />
                                    <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S26bca9141a3139fd}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,140,Auto" ColumnSpacing="10">
                                        <TextBox
                                            PlaceholderText="{x:Static tr:TriskoStrings.S53365a88d83b3a04}"
                                            Text="{Binding NewEcpServerHost, Mode=TwoWay}" />
                                        <TextBox
                                            Grid.Column="1"
                                            PlaceholderText="{x:Static tr:TriskoStrings.S90947197f86bfdea}"
                                            Text="{Binding NewEcpServerPort, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Classes="primaryAction"
                                            Command="{Binding AddEcpServerCommand}"
                                            Content="{x:Static tr:TriskoStrings.Se866622caf406a05}"
                                            IsEnabled="{Binding !IsEcpServerSettingsBusy}" />
                                    </Grid>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding EcpServerSettingsStatus}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="10" IsVisible="{Binding HasEcpServers}">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S0b74d868ec98b6b9}" />
                                <ItemsControl ItemsSource="{Binding EcpServers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="gek:TriskoEcpServerItemViewModel">
                                            <Border Margin="0,0,0,8" Padding="18,14" Classes="subCard">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Width="38" Height="38" Background="{DynamicResource TriskoSettingIconBackground}" CornerRadius="10">
                                                        <PathIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M4 4h16v12H4zm2 2v8h12V6zm3 11h6v2h3v2H6v-2h3z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Classes="sectionTitle" Text="{Binding Endpoint}" />
                                                        <TextBlock FontSize="11" Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Sbd0aeb1b4a3a69c9}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" VerticalAlignment="Center" Classes="secondaryAction" Command="{Binding RemoveCommand}" Content="{x:Static tr:TriskoStrings.Sbe99b13612015a48}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Padding="22" Classes="subCard" IsVisible="{Binding HasNoEcpServers}">
                                <StackPanel Spacing="7">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S82c062220ffa5339}" />
                                    <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Sc14c1000f1059332}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Padding="18" Classes="subCard">
                                <TextBlock FontSize="12" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{x:Static tr:TriskoStrings.S79b5f61a827a23fc}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Разблокировка сервисов -->
                

                <!-- 7. Подстраница: AnyDesk -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSettingsAnyDeskSubPage}">
                    <StackPanel Spacing="12">
                        <Button HorizontalAlignment="Left" Classes="backNav" Command="{Binding NavigateToSettingsMainCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="←" VerticalAlignment="Center" FontWeight="Bold" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.Sddbf139caa44f171}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.Sf56ec2ee34a43603}" />
                                <Border Padding="7,2" VerticalAlignment="Center" Background="{DynamicResource TriskoNavActiveBackground}" BorderBrush="{DynamicResource TriskoCardBorderHover}" BorderThickness="1" CornerRadius="6">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TriskoCardBorderHover}" Text="{Binding AnyDeskIntegrationStateText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.S295a0e48e21dafe7}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S9e7ca698564fc1a8}" />
                                    <CheckBox Content="{x:Static tr:TriskoStrings.S46b9c1538f4fe1b5}" IsChecked="{Binding IsAnyDeskIntegrationEnabled, Mode=TwoWay}" />
                                    <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Scc7c79bd045a3758}" TextWrapping="Wrap" />
                                    <CheckBox Margin="0,8,0,0"
                                              Content="{x:Static tr:TriskoStrings.S549026c576334ed8}"
                                              IsChecked="{Binding AutoStartAnyDeskOnLaunch, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAnyDeskIntegrationEnabled}" />
                                    <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S9d8f8b3262aa4992}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Padding="14" Background="#18F3B35A" BorderBrush="#75F3B35A" BorderThickness="1" CornerRadius="10" IsVisible="{Binding HasAnyDeskEnvironmentWarning}">
                                <TextBlock FontSize="12" Foreground="{DynamicResource TriskoCardTitleForeground}" Text="{Binding AnyDeskEnvironmentWarningText}" TextWrapping="Wrap" />
                            </Border>

                            <Border Padding="24" Classes="card">
                                <Border.IsVisible>
                                    <Binding Path="IsAnyDeskIntegrationEnabled" />
                                </Border.IsVisible>
                                <StackPanel Spacing="15">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Classes="settingIcon">
                                            <PathIcon Width="20" Height="20" Data="M4 5h16v11H4zm2 2v7h12V7zm3 10h6v2h3v2H6v-2h3z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="17,0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S6a5f541ef1e0adb8}" />
                                            <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Scf1371b79eeb4e91}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
                                        <TextBox
                                            VerticalContentAlignment="Center"
                                            PlaceholderText="{x:Static tr:TriskoStrings.S7f3420ecba9f9a81}"
                                            Text="{Binding AnyDeskExecutablePath, Mode=TwoWay}" />
                                        <Button Grid.Column="1" Classes="secondaryAction" Command="{Binding BrowseAnyDeskExecutableCommand}" Content="{x:Static tr:TriskoStrings.Se3663341c82c9658}" />
                                        <Button Grid.Column="2" Classes="secondaryAction" Command="{Binding UseBundledAnyDeskExecutableCommand}" Content="{x:Static tr:TriskoStrings.S36d42699b3b3ca32}" />
                                    </Grid>

                                    <Border Padding="12,9" Background="{DynamicResource TriskoSubCardBackground}" BorderBrush="{DynamicResource TriskoCardBorder}" BorderThickness="1" CornerRadius="9">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="8" Height="8" VerticalAlignment="Center" Background="{DynamicResource TriskoBrandSubtitleForeground}" CornerRadius="4" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TriskoCardTitleForeground}" Text="{Binding AnyDeskClientStatusText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            

                            <Border Padding="18" Classes="subCard">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TriskoCardTitleForeground}" Text="{Binding AnyDeskSettingsStatus}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{x:Static tr:TriskoStrings.S10084f1c3198d93a}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Classes="primaryAction" Command="{Binding SaveAnyDeskSettingsCommand}" Content="{x:Static tr:TriskoStrings.Sb4d30cae52894cf0}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 8. Подстраница: Обновления приложения -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSettingsUpdatesSubPage}">
                    <StackPanel Spacing="12">
                        <Button HorizontalAlignment="Left" Classes="backNav" Command="{Binding NavigateToSettingsMainCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="←" VerticalAlignment="Center" FontWeight="Bold" />
                                <TextBlock Text="{x:Static tr:TriskoStrings.Sddbf139caa44f171}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="pageTitle" Text="{x:Static tr:TriskoStrings.S1eb91e3a5236a9cf}" />
                            <TextBlock Classes="pageSubtitle" Text="{x:Static tr:TriskoStrings.Sd36bbb9851de118a}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Версия приложения -->
                            <Border Padding="24" Classes="card">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="settingIcon">
                                        <PathIcon Width="20" Height="20" Data="M12 21q-1.875 0-3.512-.712t-2.85-1.925t-1.925-2.85T3 12t.713-3.512t1.924-2.85t2.85-1.925T12 3q2.05 0 3.888.875T19 6.35V5q0-.425.288-.712T20 4t.713.288T21 5v4q0 .425-.288.713T20 10h-4q-.425 0-.712-.288T15 9t.288-.712T16 8h1.75q-1.025-1.4-2.525-2.2T12 5Q9.075 5 7.038 7.038T5 12t2.038 4.963T12 19q2.375 0 4.25-1.425t2.475-3.675q.125-.4.45-.6t.725-.15q.425.05.675.362t.15.688q-.725 2.975-3.15 4.888T12 21m1-9.4l2.5 2.5q.275.275.275.7t-.275.7t-.7.275t-.7-.275l-2.8-2.8q-.15-.15-.225-.337T11 11.975V8q0-.425.288-.712T12 7t.713.288T13 8z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="17,0" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S28069432212b3b59}" />
                                        <TextBlock Foreground="{DynamicResource TriskoCardTitleForeground}" Text="{Binding CurrentVersionText}" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{x:Static tr:TriskoStrings.S3b4be69d257852ae}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Static tr:TriskoStrings.S93b08f7b14651b6d}"
                                        Classes="primaryAction"
                                        Command="{Binding ShowUpdateManagerCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Width="14" Height="14" Data="M12 21q-1.875 0-3.512-.712t-2.85-1.925t-1.925-2.85T3 12t.713-3.512t1.924-2.85t2.85-1.925T12 3q2.05 0 3.888.875T19 6.35V5q0-.425.288-.712T20 4t.713.288T21 5v4q0 .425-.288.713T20 10h-4q-.425 0-.712-.288T15 9t.288-.712T16 8h1.75q-1.025-1.4-2.525-2.2T12 5Q9.075 5 7.038 7.038T5 12t2.038 4.963T12 19q2.375 0 4.25-1.425t2.475-3.675q.125-.4.45-.6t.725-.15q.425.05.675.362t.15.688q-.725 2.975-3.15 4.888T12 21m1-9.4l2.5 2.5q.275.275.275.7t-.275.7t-.7.275t-.7-.275l-2.8-2.8q-.15-.15-.225-.337T11 11.975V8q0-.425.288-.712T12 7t.713.288T13 8z" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S93b08f7b14651b6d}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Автоматическая проверка обновлений -->
                            <Border Padding="24" Classes="card">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Classes="settingIcon">
                                            <PathIcon Width="20" Height="20" Data="M12 21q-1.875 0-3.512-.712t-2.85-1.925t-1.925-2.85T3 12t.713-3.512t1.924-2.85t2.85-1.925T12 3q2.05 0 3.888.875T19 6.35V5q0-.425.288-.712T20 4t.713.288T21 5v4q0 .425-.288.713T20 10h-4q-.425 0-.712-.288T15 9t.288-.712T16 8h1.75q-1.025-1.4-2.525-2.2T12 5Q9.075 5 7.038 7.038T5 12t2.038 4.963T12 19q2.375 0 4.25-1.425t2.475-3.675q.125-.4.45-.6t.725-.15q.425.05.675.362t.15.688q-.725 2.975-3.15 4.888T12 21m1-9.4l2.5 2.5q.275.275.275.7t-.275.7t-.7.275t-.7-.275l-2.8-2.8q-.15-.15-.225-.337T11 11.975V8q0-.425.288-.712T12 7t.713.288T13 8z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="17,0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock FontSize="17" Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sad5cd071d229b680}" />
                                            <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S54ef39d369ceda08}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="14">
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="{x:Static tr:TriskoStrings.S5241b68e03914ec6}"
                                            IsChecked="{Binding AutoCheckUpdatesEnabled, Mode=TwoWay}" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                            <TextBox
                                                HorizontalContentAlignment="Center"
                                                PlaceholderText="2"
                                                Text="{Binding CheckUpdateIntervalHoursText, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Sd60b3942517669de}" />
                                        </Grid>
                                        <Button
                                            Grid.Column="2"
                                            Classes="primaryAction"
                                            Command="{Binding SaveAutoCheckUpdatesSettingsCommand}"
                                            Content="{x:Static tr:TriskoStrings.Sb4d30cae52894cf0}" />
                                    </Grid>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding AutoCheckUpdatesStatus}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Padding="18" Classes="subCard">
                                <TextBlock FontSize="12" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{x:Static tr:TriskoStrings.Sa9780bb74d8a70b0}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>
    </Grid>

    <!-- Модальное окно выбора VPN-серверов -->
    <Grid IsVisible="{Binding IsVpnServersModalOpen}">
        <!-- Затемняющий фон (backdrop), блокирующий клики по основному интерфейсу -->
        <Border Classes="modalBackdrop" PointerPressed="ModalBackdrop_PointerPressed" />

        <!-- Центрированное диалоговое окно -->
        <Border Classes="modalCard">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
                <!-- Шапка модального окна -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Width="16" Height="16" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                            <TextBlock FontSize="18" FontWeight="Bold" Classes="cardTitle" Text="{x:Static tr:TriskoStrings.S9055aad2972fdbec}" VerticalAlignment="Center" />
                            <Border
                                Margin="4,0,0,0"
                                Padding="7,2"
                                CornerRadius="6"
                                Background="{DynamicResource TriskoSubCardBackground}"
                                BorderBrush="{DynamicResource TriskoSubCardBorder}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding RegularVpnProfileCount}" />
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S35c933547d42e3cf}" />
                    </StackPanel>

                    <!-- Кнопка закрытия модального окна (✕) -->
                    <Button
                        Grid.Column="1"
                        Classes="modalCloseButton"
                        Command="{Binding CloseVpnServersModalCommand}"
                        ToolTip.Tip="{x:Static tr:TriskoStrings.S2e12c13858040b48}">
                        <PathIcon Width="12" Height="12" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Foreground="{DynamicResource TriskoCardTitleForeground}" />
                    </Button>
                </Grid>

                <!-- Статус подписки и иконочная панель действий -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <!-- Статус подписки и подсказка выбора -->
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon
                                Width="12"
                                Height="12"
                                Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"
                                Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TriskoCardTitleForeground}"
                                Text="{Binding VpnSubscriptionStatus}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            FontSize="11"
                            Classes="sectionSubtitle"
                            Text="{Binding VpnProfileSelectionHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Иконочные кнопки панели действий -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Кнопка: Проверить задержку всех серверов (спидометр) -->
                        <Button
                            Classes="vpnHeaderIconButton"
                            Command="{Binding TestAllVpnProfilesCommand}"
                            IsEnabled="{Binding CanTestLatency}"
                            ToolTip.Tip="{x:Static tr:TriskoStrings.S27c5d9725520d438}">
                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="2.5"
                                    IsVisible="{Binding IsVpnProfileTestBusy}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                    <Ellipse Width="3.5" Height="3.5" Classes="pingDot pingDot1" Fill="{DynamicResource TriskoCardBorderHover}" />
                                    <Ellipse Width="3.5" Height="3.5" Classes="pingDot pingDot2" Fill="{DynamicResource TriskoCardBorderHover}" />
                                    <Ellipse Width="3.5" Height="3.5" Classes="pingDot pingDot3" Fill="{DynamicResource TriskoCardBorderHover}" />
                                </StackPanel>
                                <PathIcon
                                    Width="15"
                                    Height="15"
                                    Data="M12 3a9 9 0 0 0-9 9c0 2.6 1.1 4.9 2.9 6.5l1.4-1.4A7 7 0 0 1 5 12a7 7 0 1 1 14 0c0 1.9-.8 3.7-2.1 5l1.4 1.4c2-1.7 3.2-4.1 3.2-6.9a9 9 0 0 0-9-9zm-1 4v5.2l3.2 3.2 1.4-1.4-2.6-2.6V7h-2z"
                                    Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                                    IsVisible="{Binding !IsVpnProfileTestBusy}" />
                            </Panel>
                        </Button>

                        <!-- Кнопка: Обновить подписку -->
                        <Button
                            Classes="vpnHeaderIconButton"
                            Command="{Binding UpdateVpnSubscriptionCommand}"
                            IsEnabled="{Binding !IsVpnSubscriptionBusy}"
                            ToolTip.Tip="{x:Static tr:TriskoStrings.Sce7e3fd182e4f60b}">
                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon
                                    Width="16"
                                    Height="16"
                                    Data="M12 21q-1.875 0-3.512-.712t-2.85-1.925t-1.925-2.85T3 12t.713-3.512t1.924-2.85t2.85-1.925T12 3q2.05 0 3.888.875T19 6.35V5q0-.425.288-.712T20 4t.713.288T21 5v4q0 .425-.288.713T20 10h-4q-.425 0-.712-.288T15 9t.288-.712T16 8h1.75q-1.025-1.4-2.525-2.2T12 5Q9.075 5 7.038 7.038T5 12t2.038 4.963T12 19q2.375 0 4.25-1.425t2.475-3.675q.125-.4.45-.6t.725-.15q.425.05.675.362t.15.688q-.725 2.975-3.15 4.888T12 21m1-9.4l2.5 2.5q.275.275.275.7t-.275.7t-.7.275t-.7-.275l-2.8-2.8q-.15-.15-.225-.337T11 11.975V8q0-.425.288-.712T12 7t.713.288T13 8z"
                                    Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                            </Panel>
                        </Button>

                        <!-- Кнопка: Настройка подписки -->
                        <Button
                            Classes="vpnHeaderIconButton"
                            Command="{Binding ConfigureVpnSubscriptionCommand}"
                            IsEnabled="{Binding !IsVpnSubscriptionBusy}"
                            ToolTip.Tip="{x:Static tr:TriskoStrings.Sa99edde904120022}">
                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon
                                    Width="14"
                                    Height="14"
                                    Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                                    Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Переключатель независимых подписок -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Classes.primaryAction="{Binding IsRegularVpnServerSection}"
                        Classes.secondaryAction="{Binding !IsRegularVpnServerSection}"
                        Command="{Binding ShowRegularVpnServerSectionCommand}"
                        Content="{x:Static tr:TriskoStrings.S2197338ca645c979}" />
                    
                </Grid>

                <!-- Два независимых списка VPN-профилей -->
                <ScrollViewer
                    Grid.Row="3"
                    MaxHeight="580"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Border
                            Padding="12"
                            Background="{DynamicResource TriskoSubCardBackground}"
                            BorderBrush="{DynamicResource TriskoSubCardBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            IsVisible="{Binding IsRegularVpnServerSection}">
                            <Grid RowDefinitions="Auto,Auto">
                                <Button
                                    Classes="groupHeaderCollapseButton"
                                    Command="{Binding ToggleRegularVpnServersExpandedCommand}"
                                    IsHitTestVisible="False"
                                    ToolTip.Tip="{x:Static tr:TriskoStrings.S4f6130b3c1dba152}">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TriskoCardTitleForeground}" Text="{x:Static tr:TriskoStrings.S2197338ca645c979}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TriskoSectionSubtitleForeground}" Text="{x:Static tr:TriskoStrings.S0b682f514be4635b}" TextWrapping="Wrap" />
                                            <ContentControl
                                                Content="{Binding RegularSubscriptionUsage}"
                                                ContentTemplate="{StaticResource SubscriptionUsageTemplate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Padding="7,2" VerticalAlignment="Center" Background="{DynamicResource TriskoCardBackground}" CornerRadius="6">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" Text="{Binding RegularVpnProfileCount}" />
                                            </Border>
                                            <Border Classes="groupChevronBorder" IsVisible="False" VerticalAlignment="Center">
                                                <PathIcon
                                                    Width="12"
                                                    Height="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Classes="groupChevronIcon"
                                                    Classes.isExpanded="{Binding IsRegularVpnServersExpanded}"
                                                    Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"
                                                    Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="8">
                <ListBox
                    x:Name="RegularVpnServersListBox"
                    Grid.Row="1"
                    MaxHeight="320"
                    Classes="vpnProfileList"
                    Classes.selectionDisabled="{Binding !CanSelectVpnProfile}"
                    AutomationProperties.Name="{x:Static tr:TriskoStrings.S0f169d8a03683fcf}"
                    IsVisible="{Binding HasRegularVpnProfiles}"
                    ItemsSource="{Binding RegularVpnProfiles}"
                    SelectedItem="{Binding SelectedVpnProfile, Mode=OneWay}"
                    SelectionChanged="VpnProfiles_SelectionChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="gek:TriskoVpnProfileOption">
                            <Grid
                                Classes="vpnProfileItemRow"
                                MinHeight="48"
                                Background="Transparent"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12"
                                PointerPressed="VpnProfileItem_PointerPressed"
                                DoubleTapped="VpnProfileItem_DoubleTapped">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Header="{x:Static tr:TriskoStrings.S38aa0ac1ffe1a361}"
                                            Command="{Binding DataContext.SelectVpnProfileCommand, ElementName=TriskoShellRoot}"
                                            CommandParameter="{Binding}" />
                                        <MenuItem
                                            Header="{x:Static tr:TriskoStrings.S3af435b32ee7f87e}"
                                            Command="{Binding DataContext.ConnectVpnProfileCommand, ElementName=TriskoShellRoot}"
                                            CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem
                                            Header="{x:Static tr:TriskoStrings.Sfd2ccf3a4291152c}"
                                            Command="{Binding DataContext.TestVpnProfileCommand, ElementName=TriskoShellRoot}"
                                            CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <!-- Иконка типа подключения -->
                                <Border
                                    Grid.Column="0"
                                    Classes="profileIconBorder"
                                    Width="36"
                                    Height="36"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource TriskoSubCardBackground}"
                                    BorderBrush="{DynamicResource TriskoCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <PathIcon
                                            Width="16"
                                            Height="16"
                                            IsVisible="{Binding IsAutomatic}"
                                            Data="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.9 17.55 11 21 11 21z"
                                            Foreground="#4F8CFF" />
                                        <PathIcon
                                            Width="16"
                                            Height="16"
                                            IsVisible="{Binding !IsAutomatic}"
                                            Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                                            Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Panel>
                                </Border>

                                <!-- Информация о сервере -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            FontSize="13"
                                            Foreground="{DynamicResource TriskoCardTitleForeground}"
                                            MaxLines="1"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Padding="6,1.5"
                                            CornerRadius="5"
                                            Background="{DynamicResource TriskoSubCardBackground}"
                                            BorderBrush="{DynamicResource TriskoCardBorder}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TriskoBrandSubtitleForeground}"
                                                Text="{Binding ProtocolName}" />
                                        </Border>
                                        <Border
                                            Padding="6,1.5"
                                            CornerRadius="5"
                                            Background="{DynamicResource TriskoNavActiveBackground}"
                                            BorderBrush="{DynamicResource TriskoCardBorderHover}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsAnyDesk}">
                                            <TextBlock
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TriskoCardBorderHover}"
                                                Text="CASCADE" />
                                        </Border>
                                        <!-- Бейдж активного профиля -->
                                        <Border
                                            Classes="activeProfileBadge"
                                            Padding="6,1.5"
                                            CornerRadius="5"
                                            Background="{DynamicResource TriskoNavActiveBackground}"
                                            BorderBrush="{DynamicResource TriskoCardBorderHover}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"
                                            IsVisible="False">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <PathIcon Width="8" Height="8" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Foreground="{DynamicResource TriskoCardBorderHover}" />
                                                <TextBlock
                                                    FontSize="9"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource TriskoCardBorderHover}"
                                                    Text="{x:Static tr:TriskoStrings.S0435a1722c022fd6}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                            Text="{Binding DetailsText}"
                                            IsVisible="{Binding GroupName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            FontFamily="Cascadia Mono, Consolas"
                                            Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                            Text="{Binding EndpointText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Пинг и кнопка проверки задержки отдельного сервера -->
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <Button Classes="favoriteAction" Classes.favorite="{Binding IsFavorite}" IsVisible="{Binding !IsAutomatic}"
                                        Command="{Binding DataContext.ToggleVpnFavoriteCommand, ElementName=TriskoShellRoot}" CommandParameter="{Binding}"
                                        ToolTip.Tip="{x:Static tr:TriskoStrings.Se7237e6807c500a2}" AutomationProperties.Name="{x:Static tr:TriskoStrings.Se7237e6807c500a2}">
                                        <PathIcon Width="16" Height="16" Data="{StaticResource FavoriteStar}" />
                                    </Button>
                                    <Border
                                        VerticalAlignment="Center"
                                        Padding="8,4"
                                        CornerRadius="8"
                                        Background="{DynamicResource TriskoSubCardBackground}"
                                        BorderBrush="{DynamicResource TriskoCardBorder}"
                                        BorderThickness="1"
                                        MinWidth="70">
                                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsTesting}">
                                                <Ellipse Width="4.5" Height="4.5" Classes="pingDot pingDot1" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                <Ellipse Width="4.5" Height="4.5" Classes="pingDot pingDot2" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                                <Ellipse Width="4.5" Height="4.5" Classes="pingDot pingDot3" Fill="{DynamicResource TriskoBrandSubtitleForeground}" />
                                            </StackPanel>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding DelayColor}"
                                                Text="{Binding DelayText}"
                                                IsVisible="{Binding !IsTesting}" />
                                        </Panel>
                                    </Border>

                                    <!-- Кнопка со спидометром для проверки пинга конкретного сервера -->
                                    <Button
                                        Classes="rowSpeedometerButton"
                                        Command="{Binding DataContext.TestVpnProfileCommand, ElementName=TriskoShellRoot}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding !IsTesting}"
                                        ToolTip.Tip="{x:Static tr:TriskoStrings.S51a2bdcb130b36fe}">
                                        <PathIcon
                                            Width="13"
                                            Height="13"
                                            Data="M12 3a9 9 0 0 0-9 9c0 2.6 1.1 4.9 2.9 6.5l1.4-1.4A7 7 0 0 1 5 12a7 7 0 1 1 14 0c0 1.9-.8 3.7-2.1 5l1.4 1.4c2-1.7 3.2-4.1 3.2-6.9a9 9 0 0 0-9-9zm-1 4v5.2l3.2 3.2 1.4-1.4-2.6-2.6V7h-2z"
                                            Foreground="{DynamicResource TriskoBrandSubtitleForeground}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                                    <TextBlock
                                        Margin="4,8"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource TriskoSectionSubtitleForeground}"
                                        IsVisible="{Binding !HasRegularVpnProfiles}"
                                        Text="{x:Static tr:TriskoStrings.S26a3de323d1aa302}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

    <!-- Модальное окно стратегии обхода сервиса -->
    

    
    
    <Grid IsVisible="{Binding IsGlobalSearchOpen}">
        <Border Classes="modalBackdrop" PointerPressed="UsabilityBackdrop_PointerPressed" />
        <Border Classes="modalCard" Width="760" MaxHeight="680" MinHeight="340">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S37f1f81b74ab6c7d}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="secondaryAction" Command="{Binding CloseGlobalSearchCommand}" Content="{x:Static tr:TriskoStrings.S7f847c8ee340a6ed}" />
                </Grid>
                <TextBox x:Name="GlobalSearchTextBox" Grid.Row="1" Text="{Binding GlobalSearchQuery, Mode=TwoWay}" PlaceholderText="{x:Static tr:TriskoStrings.S2a3b5a16ac010741}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S14dfb41e8358dfb5}" IsVisible="{Binding HasNoGlobalSearchResults}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding GlobalSearchGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gek:TriskoSearchGroup">
                                    <StackPanel Spacing="6" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Width="16" Height="16" Source="/Assets/Trisko/Icons/folder.png" />
                                            <TextBlock FontWeight="SemiBold" Classes="sectionSubtitle" Text="{Binding Name}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="14,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gek:TriskoSearchResult">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" ColumnSpacing="6">
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Classes="secondaryAction"
                                                            Command="{Binding DataContext.ActivateSearchResultCommand, ElementName=TriskoShellRoot}" CommandParameter="{Binding}">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <Panel Width="24" Height="24" VerticalAlignment="Center">
                                                                    <Image Width="24" Height="24" Source="{Binding IconPath, Converter={x:Static deskgek:StringToImageConverter.Instance}}" IsVisible="{Binding HasImageIcon}" />
                                                                    <PathIcon Width="22" Height="22" Data="{Binding IconData, Converter={x:Static deskgek:StringToGeometryConverter.Instance}}" Foreground="{DynamicResource TriskoBrandSubtitleForeground}" IsVisible="{Binding !HasImageIcon}" />
                                                                </Panel>
                                                                <StackPanel Grid.Column="1" Spacing="3">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Classes="sectionSubtitle" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                        <Button Grid.Column="1" IsVisible="{Binding IsConnection}" Classes="secondaryAction" Command="{Binding DataContext.OpenSearchResultSectionCommand, ElementName=TriskoShellRoot}" CommandParameter="{Binding}" Content="{x:Static tr:TriskoStrings.S1ef1390184e4f3b7}" ToolTip.Tip="{x:Static tr:TriskoStrings.S1cf37865bb0ee56b}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="3" Classes="sectionSubtitle" FontSize="11" Text="{x:Static tr:TriskoStrings.S645fc77610d6fb61}" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
    <Grid IsVisible="{Binding IsAnyDeskNameOpen}">
        <Border Classes="modalBackdrop" PointerPressed="UsabilityBackdrop_PointerPressed" />
        <Border Classes="modalCard" Width="500" MinHeight="0">
            <StackPanel Spacing="14">
                <TextBlock Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Sbceea86f17715a3a}" />
                <TextBlock Classes="sectionSubtitle" Text="{Binding AnyDeskNameAddress}" />
                <TextBox x:Name="AnyDeskNameTextBox" Text="{Binding AnyDeskNameDraft, Mode=TwoWay}" MaxLength="100" PlaceholderText="{x:Static tr:TriskoStrings.S148f33dcb4f1dfc3}" />
                <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Sa2ea4982193da387}" TextWrapping="Wrap" />
                <TextBlock Classes="sectionSubtitle" Text="{Binding UsabilityStatus}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="secondaryAction" Command="{Binding CloseAnyDeskNameCommand}" Content="{x:Static tr:TriskoStrings.S8fbe9b75cbdfbfa6}" />
                    <Button Classes="primaryAction" Command="{Binding SaveAnyDeskNameCommand}" Content="{x:Static tr:TriskoStrings.Sb4d30cae52894cf0}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Panel>
    </ThemeVariantScope>
</UserControl>
