<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:geksa="using:v2rayN.Desktop.Geksa">
    <!-- Matches the shared blue used by the sidebar PNG icons in every theme. -->
    <SolidColorBrush x:Key="GeksaNavIconForeground">#6BEFC3</SolidColorBrush>
    <ResourceDictionary.ThemeDictionaries>
        
        <!-- ============================== -->
        <!-- BLUE THEME (Default Geksa)     -->
        <!-- ============================== -->
        <ResourceDictionary x:Key="{x:Static geksa:GeksaThemeVariants.Brand}">
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="GeksaShellBackground">#0B1916</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarBackground">#10211D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarBorder">#2F4D43</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardBackground">#122720</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardBorder">#345349</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardBorderHover">#61EDBE</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardBackground">#19332B</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardBorder">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSeparatorBackground">#2A473D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaModalBackdropBackground">#CC0B211A</SolidColorBrush>
            
            <SolidColorBrush x:Key="GeksaNavHoverBackground">#15372C</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavActiveBackground">#1D4F3E</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavActiveBorder">#45C49A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavForeground">#96B0A7</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavActiveForeground">#EDF4FF</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaSecondaryActionBackground">#1C4235</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSecondaryActionBorder">#3D7F69</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSecondaryActionForeground">#E4F8F1</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSecondaryActionHoverBackground">#235544</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaPrimaryActionBackground">#72E5BD</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaPrimaryActionBorder">#3CAA8D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaPrimaryActionForeground">#08241B</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaPrimaryActionHoverBackground">#2D8D74</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaWarningActionBackground">#D97706</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaWarningActionBorder">#F59E0B</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaWarningActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaWarningActionHoverBackground">#B45309</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaDangerActionBackground">#B91C1C</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaDangerActionBorder">#DC2626</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaDangerActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaDangerActionHoverBackground">#991B1B</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaSidebarToggleBackground">#18372D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarToggleBorder">#2E5246</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarToggleHoverBackground">#224A3D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarToggleHoverBorder">#60E9BB</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaQuickCardBackground">#122720</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardBorder">#345349</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardHoverBackground">#183C30</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardHoverBorder">#54BB99</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardForeground">#F3F7FD</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaSettingIconBackground">#1A4839</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSettingIconForeground">#7DF1CA</SolidColorBrush>

            <!-- Texts -->
            <SolidColorBrush x:Key="GeksaBrandTitleForeground">White</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaBrandSubtitleForeground">#61EDBE</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSectionTitleForeground">White</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSectionSubtitleForeground">#85A298</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardTitleForeground">White</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardSubtitleForeground">#90A9A1</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardLabelForeground">#78978D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardValueForeground">#E5EDF8</SolidColorBrush>
            
            <SolidColorBrush x:Key="GeksaErrorBoxBackground">#351E27</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaErrorBoxBorder">#733748</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaErrorTextForeground">#F4A5B4</SolidColorBrush>

        </ResourceDictionary>

        <!-- ============================== -->
        <!-- DARK THEME (Pure Dark)         -->
        <!-- ============================== -->
        <ResourceDictionary x:Key="Dark">
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="GeksaShellBackground">#090B0A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarBackground">#181B1A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarBorder">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardBackground">#181B1A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardBorder">#404543</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardBorderHover">#71717A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardBorder">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSeparatorBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaModalBackdropBackground">#D8090B0A</SolidColorBrush>
            
            <SolidColorBrush x:Key="GeksaNavHoverBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavActiveBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavActiveBorder">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavForeground">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavActiveForeground">#FAFAFA</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaSecondaryActionBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSecondaryActionBorder">#404543</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSecondaryActionForeground">#E4E4E7</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSecondaryActionHoverBackground">#404543</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaPrimaryActionBackground">#39D7A2</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaPrimaryActionBorder">#4EE3B1</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaPrimaryActionForeground">#08241B</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaPrimaryActionHoverBackground">#30C593</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaWarningActionBackground">#D97706</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaWarningActionBorder">#F59E0B</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaWarningActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaWarningActionHoverBackground">#B45309</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaDangerActionBackground">#B91C1C</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaDangerActionBorder">#EF4444</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaDangerActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaDangerActionHoverBackground">#991B1B</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaSidebarToggleBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarToggleBorder">#404543</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarToggleHoverBackground">#404543</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarToggleHoverBorder">#A1A1AA</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaQuickCardBackground">#181B1A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardBorder">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardHoverBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardHoverBorder">#535A58</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardForeground">#FAFAFA</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaSettingIconBackground">#27272A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSettingIconForeground">#E4E4E7</SolidColorBrush>

            <!-- Texts -->
            <SolidColorBrush x:Key="GeksaBrandTitleForeground">#FAFAFA</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaBrandSubtitleForeground">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSectionTitleForeground">#FAFAFA</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSectionSubtitleForeground">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardTitleForeground">#FAFAFA</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardSubtitleForeground">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardLabelForeground">#A1A1AA</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardValueForeground">#FAFAFA</SolidColorBrush>
            
            <SolidColorBrush x:Key="GeksaErrorBoxBackground">#450A0A</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaErrorBoxBorder">#7F1D1D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaErrorTextForeground">#FECACA</SolidColorBrush>

        </ResourceDictionary>

        <!-- ============================== -->
        <!-- LIGHT THEME                    -->
        <!-- ============================== -->
        <ResourceDictionary x:Key="Light">
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="GeksaShellBackground">#EDF2F7</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarBackground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarBorder">#CDDFD9</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardBackground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardBorder">#CDDFD9</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardBorderHover">#39D7A2</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardBackground">#F1F5F9</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardBorder">#CDDFD9</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSeparatorBackground">#CDDFD9</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaModalBackdropBackground">#66122720</SolidColorBrush>
            
            <SolidColorBrush x:Key="GeksaNavHoverBackground">#E2E8F0</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavActiveBackground">#EFF6FF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavActiveBorder">#39D7A2</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavForeground">#4A665D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaNavActiveForeground">#30C593</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaSecondaryActionBackground">#F1F5F9</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSecondaryActionBorder">#CDDFD9</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSecondaryActionForeground">#122720</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSecondaryActionHoverBackground">#E2E8F0</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaPrimaryActionBackground">#39D7A2</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaPrimaryActionBorder">#30C593</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaPrimaryActionForeground">#08241B</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaPrimaryActionHoverBackground">#30C593</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaWarningActionBackground">#D97706</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaWarningActionBorder">#B45309</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaWarningActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaWarningActionHoverBackground">#B45309</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaDangerActionBackground">#B91C1C</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaDangerActionBorder">#991B1B</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaDangerActionForeground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaDangerActionHoverBackground">#991B1B</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaSidebarToggleBackground">#F1F5F9</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarToggleBorder">#CDDFD9</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarToggleHoverBackground">#E2E8F0</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSidebarToggleHoverBorder">#39D7A2</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaQuickCardBackground">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardBorder">#CDDFD9</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardHoverBackground">#F8FAFC</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardHoverBorder">#39D7A2</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaQuickCardForeground">#122720</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaSettingIconBackground">#EFF6FF</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSettingIconForeground">#39D7A2</SolidColorBrush>

            <!-- Texts -->
            <SolidColorBrush x:Key="GeksaBrandTitleForeground">#122720</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaBrandSubtitleForeground">#39D7A2</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSectionTitleForeground">#122720</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSectionSubtitleForeground">#4A665D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardTitleForeground">#122720</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaCardSubtitleForeground">#4A665D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardLabelForeground">#4A665D</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaSubCardValueForeground">#122720</SolidColorBrush>

            <SolidColorBrush x:Key="GeksaErrorBoxBackground">#FEF2F2</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaErrorBoxBorder">#F87171</SolidColorBrush>
            <SolidColorBrush x:Key="GeksaErrorTextForeground">#B91C1C</SolidColorBrush>

        </ResourceDictionary>
        
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
