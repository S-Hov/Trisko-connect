<Window
    x:Class="v2rayN.Desktop.Views.StartupSplashWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="720"
    Height="450"
    CanResize="False"
    ShowInTaskbar="False"
    ShowActivated="False"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    Background="#242423"
    Title="Trisko connect">
    <!-- Self-contained: displayed before configuration and application styles load. -->
    <Border BorderBrush="#494946" BorderThickness="1">
        <Grid RowDefinitions="*,62">
            <Grid ClipToBounds="True">
                <Image Source="/Assets/Trisko/Splash/connected-ribbons.png" Stretch="UniformToFill" />
                <Border Width="310" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Offset="0" Color="#70242423" />
                            <GradientStop Offset="1" Color="#00242423" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Margin="32,34,0,0" Width="270"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                    <!-- Preserve the exact original application icon. -->
                    <Image Width="52" Height="52" HorizontalAlignment="Left"
                           Source="/Assets/Trisko/Brand/trisko-connect.png" />
                    <TextBlock Margin="0,34,0,0" Text="Trisko connect"
                               FontSize="28" FontWeight="SemiBold" Foreground="#FAF9F6" />
                    <TextBlock x:Name="DescriptionText" Margin="0,12,0,0"
                               Text="Файлы, рабочие столы и ресурсы компании"
                               MaxWidth="210" HorizontalAlignment="Left"
                               FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="#CCCBC6" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,180" Margin="32,0">
                <TextBlock x:Name="LoadingText" Text="Загрузка…" FontSize="12"
                           Foreground="#C8C7C2" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="2" Background="#50504C"
                        VerticalAlignment="Center" ClipToBounds="True">
                    <Border Width="48" HorizontalAlignment="Left" Background="#8AB0FF">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <Border.Styles>
                            <Style Selector="Border">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.8" IterationCount="Infinite">
                                        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="TranslateTransform.X" Value="132" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Border.Styles>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
