<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gek="clr-namespace:ServiceLib.Trisko;assembly=ServiceLib"
             xmlns:local="using:v2rayN.Desktop.Trisko"
             x:Class="v2rayN.Desktop.Trisko.TriskoConnectionButton"
             x:Name="ConnectionButtonRoot"
             x:DataType="gek:TriskoShellViewModel">
    <UserControl.Styles>
        <Style Selector="Button.powerAction">
            <Setter Property="Width" Value="176" />
            <Setter Property="Height" Value="176" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="88" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
                <ScaleTransform />
            </Setter>
        </Style>
        <Style Selector="Button.powerAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#18FFFFFF" />
        </Style>
        <Style Selector="Button.powerAction:disabled">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.powerAction:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>
    <Grid Width="244" Height="244">
        <local:TriskoConnectingOrb
            IdleBackground="{DynamicResource TriskoOrbIdleBackground}"
            IdleBorder="{DynamicResource TriskoOrbIdleBorder}"
            AccentColor="{Binding StatusColor}"
            StateKey="{Binding ConnectionStatusBadge}"
            IsIdle="{Binding IsConnectionIdle}"
            IsAnimationEnabled="{Binding IsAnimationEnabled, ElementName=ConnectionButtonRoot}" />
        <Button
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding ConnectionButtonText}"
            Classes="powerAction"
            Command="{Binding RunPrimaryActionCommand}"
            IsEnabled="{Binding CanRunPrimaryAction}">
            <!-- Прозрачный фон растягивает hit-test на всю площадь кнопки. -->
            <Grid Background="Transparent">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="7">
                    <!-- Вектор из on-button-svgrepo-com.svg: не зависит от наличия Unicode-глифа ⏻ в Windows 10. -->
                    <Viewbox Width="56" Height="56" HorizontalAlignment="Center" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path
                                Data="M10.5 6.57575C10.5 6.39592 10.5 6.30601 10.438 6.2611C10.376 6.21618 10.2935 6.24325 10.1285 6.29738C7.73122 7.08369 6 9.33953 6 11.9997C6 15.3134 8.68629 17.9997 12 17.9997C15.3137 17.9997 18 15.3134 18 11.9997C18 9.33953 16.2688 7.08369 13.8715 6.29738C13.7065 6.24325 13.624 6.21618 13.562 6.2611C13.5 6.30601 13.5 6.39592 13.5 6.57575V8.99977C13.5 9.8282 12.8284 10.4998 12 10.4998C11.1716 10.4998 10.5 9.8282 10.5 8.99977V6.57575Z"
                                Fill="White"
                                Opacity="0.22" />
                            <Path
                                Data="M12 9L12 4"
                                Stroke="White"
                                StrokeLineCap="Round"
                                StrokeThickness="1.5" />
                            <Path
                                Data="M18.0104 5.98959C19.1992 7.17834 20.0087 8.69289 20.3367 10.3417C20.6646 11.9906 20.4963 13.6996 19.853 15.2528C19.2096 16.806 18.1202 18.1335 16.7223 19.0675C15.3245 20.0015 13.6811 20.5 12 20.5C10.3189 20.5 8.67547 20.0015 7.27765 19.0675C5.87984 18.1335 4.79037 16.806 4.14702 15.2528C3.50368 13.6996 3.33535 11.9906 3.66332 10.3417C3.9913 8.69289 4.80085 7.17834 5.98959 5.98959"
                                Stroke="White"
                                StrokeLineCap="Round"
                                StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock
                        MaxWidth="130"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding ConnectionButtonText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
