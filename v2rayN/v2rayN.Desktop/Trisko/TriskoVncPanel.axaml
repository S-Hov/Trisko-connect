<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tr="clr-namespace:ServiceLib.Trisko;assembly=ServiceLib"
             xmlns:local="using:v2rayN.Desktop.Trisko"
             x:Class="v2rayN.Desktop.Trisko.TriskoVncPanel">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="VncConnectionCards">
            <local:TriskoResponsiveGridPanel MinItemWidth="300" Spacing="12" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <WrapPanel ItemSpacing="10" LineSpacing="6" VerticalAlignment="Center">
                <TextBlock Classes="sectionSubtitle" Text="{Binding $parent[local:TriskoVncPanel].StatusText}" VerticalAlignment="Center" />
                <Button x:Name="QuickWorkButton" Classes="secondaryAction" Click="QuickWork_Click" IsVisible="False" />
                <StackPanel x:Name="WorkstationIdentity" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="False">
                    <TextBlock x:Name="WorkstationLabel" Classes="sectionSubtitle" VerticalAlignment="Center" />
                    <SelectableTextBlock x:Name="WorkstationValue" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="SetupIncomingButton" Classes="secondaryAction" Content="{x:Static tr:TriskoStrings.S21cb41929dcb9b94}"
                        Click="SetupIncoming_Click" IsVisible="False" />
            </WrapPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Classes="secondaryAction" Content="{x:Static tr:TriskoStrings.S985b5e0f2ccf1ba0}"
                    Click="OpenSettings_Click" AutomationProperties.Name="{x:Static tr:TriskoStrings.S5244e86a155f9941}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="HostBox" Classes="remoteInput" PlaceholderText="{x:Static tr:TriskoStrings.Sd343cbabc004b778}" AutomationProperties.Name="{x:Static tr:TriskoStrings.S4c8fcd6da1bf3b9f}" />
            <Button Grid.Column="1" Classes="primaryAction" Content="{x:Static tr:TriskoStrings.S36b4c0b07f08c596}" Click="Connect_Click" />
        </Grid>
        <TextBlock x:Name="ClientStatus" Classes="sectionSubtitle" TextWrapping="Wrap"
                   IsVisible="{Binding #ClientStatus.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel x:Name="PinnedPanel" Spacing="6" IsVisible="False">
            <TextBlock Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.S40cdef60755c34b3}" />
            <ItemsControl x:Name="PinnedList" ItemsPanel="{StaticResource VncConnectionCards}" />
        </StackPanel>
        <StackPanel x:Name="FavoritePanel" Spacing="6" IsVisible="False">
            <TextBlock Classes="sectionTitle" Text="{x:Static tr:TriskoStrings.Se4c1d01c5c8f2193}" />
            <ItemsControl x:Name="FavoriteList" ItemsPanel="{StaticResource VncConnectionCards}" />
        </StackPanel>
        <StackPanel x:Name="DiscoveryPanel" Spacing="6" IsVisible="False">
            <TextBlock x:Name="DiscoveryStatus" Classes="sectionSubtitle" TextWrapping="Wrap" />
            <ItemsControl x:Name="WorkplaceList" ItemsPanel="{StaticResource VncConnectionCards}" IsVisible="False" />
        </StackPanel>
        <StackPanel x:Name="HistoryPanel" Spacing="6" IsVisible="False">
            <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S60ba8b1a759773a0}" />
            <ItemsControl x:Name="HistoryList" ItemsPanel="{StaticResource VncConnectionCards}" />
        </StackPanel>

        <ContentControl x:Name="SettingsSlot" IsVisible="False">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,110" ColumnSpacing="12">
                    <TextBlock Classes="sectionSubtitle" VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.Seb476cc933e1da11}" />
                    <TextBox x:Name="ClientPortBox" Grid.Column="1" Text="5900" AutomationProperties.Name="{x:Static tr:TriskoStrings.S1c01e643ae71aedc}" />
                </Grid>
                <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Se924243b8513f09f}" TextWrapping="Wrap" />
                
                <Expander x:Name="WorkNetworkPanel" Header="{x:Static tr:TriskoStrings.Sed77c63a04ba7a30}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="False">
                    <StackPanel Spacing="10" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
                            <TextBox x:Name="WorkHostBox" PlaceholderText="{x:Static tr:TriskoStrings.Sef6d20aed29f5caa}" AutomationProperties.Name="{x:Static tr:TriskoStrings.Sef6d20aed29f5caa}" />
                            <TextBox x:Name="WorkPortBox" Grid.Column="1" PlaceholderText="{x:Static tr:TriskoStrings.S90947197f86bfdea}" AutomationProperties.Name="{x:Static tr:TriskoStrings.S0aec9df4b66b3bae}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <TextBox x:Name="WorkHubBox" PlaceholderText="{x:Static tr:TriskoStrings.S135a15058cff130a}" AutomationProperties.Name="{x:Static tr:TriskoStrings.S135a15058cff130a}" />
                            <TextBox x:Name="WorkUsernameBox" Grid.Column="1" PlaceholderText="{x:Static tr:TriskoStrings.S9516a2a9ecf92285}" AutomationProperties.Name="{x:Static tr:TriskoStrings.S9516a2a9ecf92285}" />
                        </Grid>
                        <TextBox x:Name="WorkSubnetBox" PlaceholderText="{x:Static tr:TriskoStrings.S36eef2169f76785e}" AutomationProperties.Name="{x:Static tr:TriskoStrings.S36eef2169f76785e}" />
                        <TextBox x:Name="WorkPasswordBox" PasswordChar="●" MaxLength="63" PlaceholderText="{x:Static tr:TriskoStrings.Sf981e6008c196dee}" AutomationProperties.Name="{x:Static tr:TriskoStrings.Sf981e6008c196dee}" />
                        <CheckBox x:Name="AutoWorkBox" Content="{x:Static tr:TriskoStrings.S284ddaa509b32b98}" />
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button x:Name="SaveWorkButton" Classes="triskoSecondary" Content="{x:Static tr:TriskoStrings.Sd3257f0c9ba359c3}" Click="SaveWork_Click" />
                            <Button x:Name="ConnectWorkButton" Classes="triskoPrimary" Content="{x:Static tr:TriskoStrings.Sbcafa808f0871ba2}" Click="ConnectWork_Click" />
                            <Button x:Name="DisconnectWorkButton" Classes="triskoSecondary" Content="{x:Static tr:TriskoStrings.Sbb5bdd176cdf98df}" Click="DisconnectWork_Click" IsEnabled="False" />
                        </WrapPanel>
                        <TextBlock x:Name="WorkNetworkStatus" Classes="sectionSubtitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="WorkNetworkFeedback" Classes="sectionSubtitle" TextWrapping="Wrap"
                                   IsVisible="{Binding #WorkNetworkFeedback.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="VncServerPanel" Header="{x:Static tr:TriskoStrings.Sb7bf4b3f92aae694}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S6bba98e71580523c}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Classes="sectionSubtitle" VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S5366ea3494b9c44f}" />
                            <TextBox x:Name="ServerPortBox" Grid.Column="1" Text="5900" MaxWidth="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Classes="sectionSubtitle" VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.Sf104cf99dcdb5ddf}" />
                            <TextBox x:Name="ServerPasswordBox" Grid.Row="1" Grid.Column="1" PasswordChar="●" MaxLength="8" PlaceholderText="{x:Static tr:TriskoStrings.S8867fd2ed76b1729}" />
                            <TextBlock Grid.Row="2" Classes="sectionSubtitle" VerticalAlignment="Center" Text="{x:Static tr:TriskoStrings.S5b6b9cebd7cd1a2d}" />
                            <TextBox x:Name="AllowedAddressesBox" Grid.Row="2" Grid.Column="1" Text="LocalSubnet" PlaceholderText="{x:Static tr:TriskoStrings.Sf3e3f8295e679989}" />
                        </Grid>
                        <TextBlock Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.S2040cb3df1574a52}" TextWrapping="Wrap" />
                        <Button x:Name="UseWorkSubnetButton" Classes="triskoSecondary" Content="{x:Static tr:TriskoStrings.S797dc757ed10b3d4}"
                                Click="UseWorkSubnet_Click" IsVisible="False" />
                        <CheckBox x:Name="AutoStartBox" Content="{x:Static tr:TriskoStrings.Saf4d8d4b87280730}" />
                        <CheckBox x:Name="LoopbackBox" Content="{x:Static tr:TriskoStrings.S76de79c683ce74de}" />
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button x:Name="EnableServerButton" Classes="triskoPrimary" Content="{x:Static tr:TriskoStrings.S88995740eb7a1d35}" Click="EnableServer_Click" />
                            <Button x:Name="DisableServerButton" Classes="triskoSecondary" Content="{x:Static tr:TriskoStrings.S5c2e70b2a351eae9}" Click="DisableServer_Click" />
                            <Button x:Name="RefreshServerButton" Classes="triskoSecondary" Content="{x:Static tr:TriskoStrings.S83553fb558576062}" Click="RefreshServer_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="ServerStatus" Classes="sectionSubtitle" Text="{x:Static tr:TriskoStrings.Scdd8b6cd4b65cb5a}" TextWrapping="Wrap" />
                        <TextBlock x:Name="LocalAddresses" Classes="sectionSubtitle" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
